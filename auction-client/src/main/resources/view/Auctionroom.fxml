<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>

<!--
  ╔══════════════════════════════════════════════════════════╗
  ║     GEMINI — Live Auction Room  (AnchorPane 1280×900)    ║
  ║     Controller: AuctionRoomController                    ║
  ╚══════════════════════════════════════════════════════════╝

  fx:id catalogue
  ──────────────────────────────────────────────────────────
  [Product]
    imgProduct          — ảnh sản phẩm (set bởi ProductPanelController)
    lblImgPlaceholder   — emoji placeholder khi chưa có ảnh
    lblProductName      — tên sản phẩm
    lblProductDesc      — mô tả sản phẩm

  [Timer / Bid Info]
    lblCountdown        — HH:MM:SS countdown
    lblSoftClose        — anti-snipe notice
    lblCurrentBid       — giá cao nhất hiện tại
    lblBidStatus        — trạng thái đặt giá (feedback)

  [Manual Bid]
    txtCustomBid        — text field nhập giá
    btnQuickBid1/2/3    — quick-fill +1/3/5 bước (filled by ManualBidController)
    btnConfirmBid       — nút xác nhận đặt giá (primary)
    btnPlaceBid         — nút đặt giá ngay (secondary)

  [Auto-Bid]
    txtMaxBid           — giá tối đa auto-bid
    txtIncrement        — bước tăng auto-bid
    btnSetAutoBid       — bật auto-bid
    btnCancelAutoBid    — huỷ auto-bid
    lblAutoBidStatus    — thông báo trạng thái (auto-hide)
    lblAutoBidInfo      — thông tin cài đặt hiện tại

  [Chart]
    chartPriceLive      — LineChart giá theo thời gian
    axisChartX          — trục X (mốc)
    axisChartY          — trục Y (giá USD)
    lblChartLastUpdate  — nhãn thời điểm cập nhật

  [History]
    vboxBidHistory      — VBox chứa các bid row (dynamic)
    scrollHistory       — ScrollPane bọc vboxBidHistory

  [Misc]
    lblViewerCount      — số người đang xem
    btnCloseRoom        — nút đóng phòng
-->

<AnchorPane fx:id="rootPane" prefHeight="900.0" prefWidth="1280.0"
  style="-fx-background-color: #F4F7FC;"
  stylesheets="@../css/styles.css"
  xmlns="http://javafx.com/javafx/17.0.12"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.nhom15.client.controller.AuctionRoomController">

  <children>

    <!-- ░░░ ANIMATED BACKGROUND ░░░ -->
    <Pane fx:id="paneBackground" mouseTransparent="true"
      AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

    <!-- ░░░ ROOT VBOX ░░░ -->
    <VBox spacing="0.0"
      AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
      AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

      <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
      <HBox fx:id="headerBar" alignment="CENTER_LEFT" prefHeight="64.0" spacing="0.0"
        style="-fx-background-color: white;
                   -fx-border-color: transparent transparent #E8EAED transparent;
                   -fx-border-width: 0 0 1 0;">
        <padding><Insets left="28.0" right="28.0" /></padding>

        <!-- Logo -->
        <StackPane prefHeight="28.0" prefWidth="28.0">
          <ImageView fitHeight="68.0" fitWidth="158.0" pickOnBounds="true" preserveRatio="true">
            <image><Image url="@../images/Google-Gemini-Logo.png" /></image>
          </ImageView>
        </StackPane>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Nav links -->
        <HBox alignment="CENTER" spacing="4.0">
          <Button mnemonicParsing="false"
            style="-fx-background-color: transparent; -fx-text-fill: #202124;
                         -fx-cursor: hand; -fx-font-size: 13.5;"/>
          <Button mnemonicParsing="false"
            style="-fx-background-color: transparent; -fx-text-fill: #202124;
                         -fx-cursor: hand; -fx-font-size: 13.5;"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Social + close -->
        <HBox alignment="CENTER" spacing="18.0">
          <Label style="-fx-text-fill: #606368; -fx-font-size: 18; -fx-cursor: hand;"/>
          <Label style="-fx-text-fill: #606368; -fx-font-size: 18; -fx-cursor: hand;"/>
          <Label style="-fx-text-fill: #606368; -fx-font-size: 18; -fx-cursor: hand;"/>
          <Button fx:id="btnCloseRoom" mnemonicParsing="false" onAction="#handleCloseRoom"
            focusTraversable="false" text="✕"
            style="-fx-background-color: transparent; -fx-text-fill: #606368;
                         -fx-cursor: hand; -fx-font-size: 18;
                         -fx-padding: 4 10 4 10; -fx-min-width: 36; -fx-min-height: 36;">
            <font><Font size="18.0" /></font>
          </Button>
        </HBox>
      </HBox>

      <!-- ══ LIVE STATUS RIBBON ═══════════════════════════════════════════ -->
      <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="12.0"
        style="-fx-background-color: white;
                   -fx-border-color: transparent transparent #E8EAED transparent;
                   -fx-border-width: 0 0 1 0;">
        <padding><Insets left="28.0" right="28.0" /></padding>

        <StackPane>
          <Rectangle arcHeight="14.0" arcWidth="14.0" fill="#FF4444" height="24.0" width="64.0" />
          <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="● LIVE" textFill="white">
            <font><Font size="11.0" /></font>
          </Label>
        </StackPane>

        <Label style="-fx-text-fill: #606368; -fx-font-size: 13;"
          text="Phiên đấu giá đang diễn ra">
          <font><Font size="13.0" /></font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblViewerCount" style="-fx-text-fill: #888888; -fx-font-size: 12;"
          text="👥  -- người đang xem">
          <font><Font size="12.0" /></font>
        </Label>
      </HBox>

      <!-- ══ SCROLLABLE MAIN CONTENT ══════════════════════════════════════ -->
      <ScrollPane fitToWidth="true"
        style="-fx-background-color: #F4F7FC;
                         -fx-background: #F4F7FC;
                         -fx-border-color: transparent;"
        VBox.vgrow="ALWAYS">
        <content>
          <VBox spacing="0.0" style="-fx-background-color: #F4F7FC;">
            <padding><Insets bottom="48.0" left="40.0" right="40.0" top="28.0" /></padding>

            <!-- ┌─ TWO-COLUMN LAYOUT ───────────────────────────────────┐ -->
            <HBox spacing="24.0" VBox.vgrow="ALWAYS">

              <!-- ═══ LEFT COLUMN — Product Gallery + Info ══════════════ -->
              <VBox spacing="18.0" HBox.hgrow="ALWAYS">

                <!-- Main product image -->
                <StackPane prefHeight="360.0"
                  style="-fx-background-color: white;
                                  -fx-background-radius: 18;
                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),24,0,0,6);">
                  <Circle fill="transparent" opacity="0.5" radius="130.0"
                    stroke="#E8EAED" strokeWidth="1.0" />
                  <Label fx:id="lblImgPlaceholder"
                    style="-fx-font-size: 160; -fx-opacity: 0.92;" text="⌚" />
                  <ImageView fx:id="imgProduct"
                    fitHeight="340.0" fitWidth="600.0"
                    pickOnBounds="true" preserveRatio="true" visible="false" />
                  <StackPane StackPane.alignment="TOP_LEFT">
                    <Rectangle arcHeight="0.0" arcWidth="0.0"
                      fill="#4285F4" height="28.0" width="72.0" />
                    <Label style="-fx-font-weight: bold; -fx-font-size: 11;"
                      text="LOT" textFill="white">
                      <font><Font size="11.0" /></font>
                    </Label>
                  </StackPane>
                  <Label style="-fx-text-fill: #9B72CB; -fx-font-size: 22; -fx-opacity: 0.4;"
                    text="✦" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets right="16.0" top="12.0" /></StackPane.margin>
                  </Label>
                  <Label style="-fx-font-size: 18; -fx-opacity: 0.6; -fx-cursor: hand;"
                    text="🔍" StackPane.alignment="BOTTOM_RIGHT">
                    <StackPane.margin><Insets bottom="14.0" right="16.0" /></StackPane.margin>
                  </Label>
                </StackPane>

                <!-- Product Info Card -->
                <VBox spacing="14.0"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),20,0,0,4);">
                  <padding><Insets bottom="26.0" left="26.0" right="26.0" top="26.0" /></padding>

                  <Label fx:id="lblProductName"
                    style="-fx-text-fill: #202124; -fx-font-weight: bold;"
                    text="Đang tải..." wrapText="true">
                    <font><Font name="Arial" size="20.0" /></font>
                  </Label>

                  <Label fx:id="lblProductDesc"
                    style="-fx-text-fill: #606368; -fx-line-spacing: 3;"
                    text="" wrapText="true">
                    <font><Font size="13.5" /></font>
                  </Label>

                  <!-- Verified badge -->
                  <HBox alignment="CENTER_LEFT" spacing="0.0">
                    <VBox.margin><Insets top="2.0" /></VBox.margin>
                    <StackPane>
                      <Rectangle arcHeight="22.0" arcWidth="22.0"
                        fill="#E8F5E9" height="34.0" width="226.0" />
                      <HBox alignment="CENTER_LEFT" spacing="7.0">
                        <padding><Insets left="13.0" right="13.0" /></padding>
                        <Label style="-fx-text-fill: #34A853; -fx-font-weight: bold;
                                      -fx-font-size: 14;" text="✓">
                          <font><Font size="14.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #34A853; -fx-font-size: 13;
                                      -fx-font-weight: bold;" text="Đã xác minh tính xác thực">
                          <font><Font size="13.0" /></font>
                        </Label>
                      </HBox>
                    </StackPane>
                  </HBox>

                  <Separator style="-fx-opacity: 0.4;" />

                  <!-- Specs 2x2 grid -->
                  <GridPane fx:id="gridSpecs" hgap="10.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints percentWidth="50.0" />
                      <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>
                    <!-- Children will be generated dynamically by ProductPanelController -->
                  </GridPane>
                </VBox>
              </VBox>
              <!-- END LEFT COLUMN -->


              <!-- ═══ RIGHT COLUMN — Auction Control Panel (fixed 370px) ═ -->
              <VBox minWidth="350.0" prefWidth="370.0" spacing="16.0">

                <!-- Panel title -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                  <Label style="-fx-text-fill: #9B72CB; -fx-font-size: 16;" text="✦">
                    <font><Font size="16.0" /></font>
                  </Label>
                  <Label style="-fx-text-fill: #202124; -fx-font-weight: bold;"
                    text="Auction Control Panel">
                    <font><Font size="18.0" /></font>
                  </Label>
                </HBox>

                <!-- ┌─ COUNTDOWN + CURRENT BID ───────────────────────────┐ -->
                <VBox spacing="0.0"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.09),24,0,0,6);">

                  <!-- Timer -->
                  <StackPane fx:id="timerPane" prefHeight="116.0"
                    style="-fx-background-color: #1a1a2e;
                                    -fx-background-radius: 18 18 0 0;">
                    <Circle fill="transparent" opacity="0.15" radius="44.0"
                      stroke="white" strokeWidth="1.0" />
                    <VBox alignment="CENTER" spacing="5.0">
                      <Label fx:id="lblCountdown"
                        style="-fx-font-weight: bold;
                                    -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.25),8,0,0,3);"
                        text="--:--" textFill="white">
                        <font><Font size="54.0" /></font>
                      </Label>
                      <HBox alignment="CENTER" spacing="5.0">
                        <Label style="-fx-font-size: 11; -fx-opacity: 0.9;"
                          text="⚠" textFill="white"/>
                        <Label fx:id="lblSoftClose"
                          style="-fx-font-size: 11; -fx-opacity: 0.9;"
                          text="Luật Soft Close — Đếm ngược" textFill="white">
                          <font><Font size="11.0" /></font>
                        </Label>
                      </HBox>
                    </VBox>
                    <Circle fx:id="dotPulse" fill="#FF3333" radius="5.5"
                      StackPane.alignment="TOP_RIGHT">
                      <StackPane.margin><Insets right="14.0" top="13.0" /></StackPane.margin>
                    </Circle>
                  </StackPane>

                  <!-- Current bid -->
                  <VBox alignment="CENTER" spacing="4.0"
                    style="-fx-background-color: white; -fx-background-radius: 0 0 18 18;">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                    <Label style="-fx-text-fill: #888888; -fx-font-size: 12.5;"
                      text="Mức giá cao nhất hiện tại"/>
                    <Label fx:id="lblCurrentBid"
                      style="-fx-text-fill: #1A73E8; -fx-font-weight: bold;"
                      text="---">
                      <font><Font size="36.0" /></font>
                    </Label>
                    <HBox alignment="CENTER" spacing="5.0">
                      <Label style="-fx-text-fill: #34A853; -fx-font-weight: bold;
                                    -fx-font-size: 12;" text="✓"/>
                      <Label fx:id="lblBidStatus"
                        style="-fx-text-fill: #34A853; -fx-font-size: 12.5;
                                    -fx-font-weight: bold;" text="Mức giá sàn đã đạt">
                        <font><Font size="12.5" /></font>
                      </Label>
                    </HBox>
                  </VBox>
                </VBox>
                <!-- END COUNTDOWN + BID -->


                <!-- ┌─ BIDDING CONTROLS ──────────────────────────────────┐ -->
                <VBox spacing="14.0"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),20,0,0,4);">
                  <padding><Insets bottom="22.0" left="20.0" right="20.0" top="20.0" /></padding>

                  <!-- Bước giá notice -->
                  <HBox alignment="CENTER_LEFT" spacing="6.0"
                    style="-fx-background-color: #F4F7FC; -fx-background-radius: 8;">
                    <padding><Insets bottom="9.0" left="12.0" right="12.0" top="9.0" /></padding>
                    <Label style="-fx-font-size: 13;" text="📋"/>
                    <Label style="-fx-text-fill: #606368; -fx-font-size: 12.5;"
                      text="Bước giá tối thiểu:"/>
                    <Label style="-fx-text-fill: #202124; -fx-font-weight: bold;
                                  -fx-font-size: 13;" text=""/>
                  </HBox>

                  <!-- Quick-bid buttons (+1/+3/+5 bước) -->
                  <HBox spacing="8.0">
                    <Button fx:id="btnQuickBid1" maxWidth="Infinity"
                      mnemonicParsing="false" onAction="#handleQuickBid1"
                      prefHeight="42.0"
                      style="-fx-background-color: #EEF3FE; -fx-text-fill: #4285F4;
                                   -fx-font-weight: bold; -fx-background-radius: 21;
                                   -fx-cursor: hand; -fx-font-size: 12;"
                      text="+1 bước" HBox.hgrow="ALWAYS">
                      <font><Font size="12.0" /></font>
                    </Button>
                    <Button fx:id="btnQuickBid2" maxWidth="Infinity"
                      mnemonicParsing="false" onAction="#handleQuickBid2"
                      prefHeight="42.0"
                      style="-fx-background-color: #F3EEFB; -fx-text-fill: #9B72CB;
                                   -fx-font-weight: bold; -fx-background-radius: 21;
                                   -fx-cursor: hand; -fx-font-size: 12;"
                      text="+3 bước" HBox.hgrow="ALWAYS">
                      <font><Font size="12.0" /></font>
                    </Button>
                    <Button fx:id="btnQuickBid3" maxWidth="Infinity"
                      mnemonicParsing="false" onAction="#handleQuickBid3"
                      prefHeight="42.0"
                      style="-fx-background-color: #FDEEF0; -fx-text-fill: #D96570;
                                   -fx-font-weight: bold; -fx-background-radius: 21;
                                   -fx-cursor: hand; -fx-font-size: 12;"
                      text="+5 bước" HBox.hgrow="ALWAYS">
                      <font><Font size="12.0" /></font>
                    </Button>
                  </HBox>

                  <!-- Custom bid input -->
                  <TextField fx:id="txtCustomBid" maxWidth="Infinity" prefHeight="46.0"
                    promptText="Nhập số tiền (VD: 16500000)"
                    style="-fx-background-color: #F4F7FC;
                                    -fx-background-radius: 23;
                                    -fx-border-color: #E8EAED;
                                    -fx-border-radius: 23;
                                    -fx-border-width: 1.5;
                                    -fx-padding: 0 18 0 18;
                                    -fx-font-size: 13.5;">
                    <font><Font size="13.5" /></font>
                  </TextField>

                  <!-- Primary CTA -->
                  <Button fx:id="btnConfirmBid" maxWidth="Infinity"
                    mnemonicParsing="false" onAction="#handleConfirmBid"
                    prefHeight="50.0" text="🔨  Xác nhận đặt giá"
                    style="-fx-background-color: linear-gradient(to right, #4285F4, #1A73E8);
                                 -fx-text-fill: white; -fx-font-weight: bold;
                                 -fx-background-radius: 25; -fx-cursor: hand;
                                 -fx-font-size: 14.5;">
                    <font><Font size="14.5" /></font>
                    <effect>
                      <DropShadow height="14.0" offsetY="4.0" radius="7.0" width="14.0">
                        <color><Color red="0.26" green="0.32" blue="0.91" opacity="0.38" /></color>
                      </DropShadow>
                    </effect>
                  </Button>

                  <!-- Secondary CTA -->
                  <Button fx:id="btnPlaceBid" maxWidth="Infinity"
                    mnemonicParsing="false" onAction="#handlePlaceBid"
                    prefHeight="46.0" text="Đặt giá ngay"
                    style="-fx-background-color: #FFFFFF;
                                 -fx-border-color: #4285F4;
                                 -fx-border-radius: 23;
                                 -fx-background-radius: 23;
                                 -fx-border-width: 1.8;
                                 -fx-text-fill: #4285F4;
                                 -fx-font-weight: bold;
                                 -fx-cursor: hand;
                                 -fx-font-size: 13.5;">
                    <font><Font size="13.5" /></font>
                  </Button>
                </VBox>
                <!-- END BIDDING CONTROLS -->


                <!-- ┌─ AUTO-BID PANEL ─────────────────────────────────────┐ -->
                <VBox spacing="12.0"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),20,0,0,4);">
                  <padding><Insets bottom="18.0" left="20.0" right="20.0" top="18.0" /></padding>

                  <!-- Header -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label style="-fx-font-size: 15;" text="⚡"/>
                    <Label style="-fx-text-fill: #202124; -fx-font-weight: bold;"
                      text="Tự động đặt giá (Auto-Bid)">
                      <font><Font size="15.0" /></font>
                    </Label>
                  </HBox>

                  <!-- Status info -->
                  <Label fx:id="lblAutoBidInfo"
                    style="-fx-text-fill: #888888; -fx-font-size: 12px;
                                -fx-background-color: #F4F7FC;
                                -fx-background-radius: 8; -fx-padding: 8 12;"
                    text="❌ Auto-Bid đang TẮT — Hệ thống sẽ không tự đặt giá."
                    wrapText="true" maxWidth="Infinity">
                    <font><Font size="12.0" /></font>
                  </Label>

                  <!-- Max bid -->
                  <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #606368; -fx-font-size: 12;"
                      text="Giá tối đa (VNĐ)"/>
                    <TextField fx:id="txtMaxBid" maxWidth="Infinity" prefHeight="40.0"
                      promptText="VD: 5000000"
                      style="-fx-background-color: #F4F7FC;
                                      -fx-background-radius: 20;
                                      -fx-border-color: #E8EAED;
                                      -fx-border-radius: 20;
                                      -fx-border-width: 1.5;
                                      -fx-padding: 0 15 0 15;
                                      -fx-font-size: 13;">
                      <font><Font size="13.0" /></font>
                    </TextField>
                  </VBox>

                  <!-- Increment -->
                  <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #606368; -fx-font-size: 12;"
                      text="Bước tăng tự động (VNĐ)"/>
                    <TextField fx:id="txtIncrement" maxWidth="Infinity" prefHeight="40.0"
                      promptText="VD: 50000"
                      style="-fx-background-color: #F4F7FC;
                                      -fx-background-radius: 20;
                                      -fx-border-color: #E8EAED;
                                      -fx-border-radius: 20;
                                      -fx-border-width: 1.5;
                                      -fx-padding: 0 15 0 15;
                                      -fx-font-size: 13;">
                      <font><Font size="13.0" /></font>
                    </TextField>
                  </VBox>

                  <!-- Buttons -->
                  <HBox spacing="10.0">
                    <Button fx:id="btnSetAutoBid" maxWidth="Infinity"
                      mnemonicParsing="false" onAction="#handleSetAutoBid"
                      prefHeight="40.0" text="⚡ Bật Auto-Bid"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #4285F4; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-background-radius: 20;
                                   -fx-cursor: hand; -fx-font-size: 12.5;">
                      <font><Font size="12.5" /></font>
                    </Button>
                    <Button fx:id="btnCancelAutoBid" maxWidth="Infinity"
                      mnemonicParsing="false" onAction="#handleCancelAutoBid"
                      prefHeight="40.0" text="✕ Huỷ"
                      HBox.hgrow="ALWAYS" disable="true"
                      style="-fx-background-color: #FDEEF0; -fx-text-fill: #D96570;
                                   -fx-font-weight: bold; -fx-background-radius: 20;
                                   -fx-border-color: #D96570; -fx-border-radius: 20;
                                   -fx-border-width: 1.5; -fx-cursor: hand; -fx-font-size: 12.5;">
                      <font><Font size="12.5" /></font>
                    </Button>
                  </HBox>

                  <!-- Status message (auto-hide) -->
                  <Label fx:id="lblAutoBidStatus" maxWidth="Infinity"
                    style="-fx-font-size: 12px; -fx-text-fill: #888888;"
                    text="" visible="false" wrapText="true">
                    <font><Font size="12.0" /></font>
                  </Label>
                </VBox>
                <!-- END AUTO-BID -->


                <!-- ┌─ LIVE PRICE CHART ──────────────────────────────────┐ -->
                <VBox spacing="10.0"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),20,0,0,4);">
                  <padding><Insets bottom="16.0" left="16.0" right="16.0" top="16.0" /></padding>

                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label style="-fx-text-fill: #1A73E8; -fx-font-size: 15;
                                  -fx-font-weight: bold;" text="📈 Biểu đồ giá (live)">
                      <font><Font size="15.0" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblChartLastUpdate"
                      style="-fx-text-fill: #888888; -fx-font-size: 11;" text="—">
                      <font><Font size="11.0" /></font>
                    </Label>
                  </HBox>

                  <LineChart fx:id="chartPriceLive"
                    animated="false" createSymbols="true" legendVisible="false"
                    minHeight="180.0" prefHeight="220.0"
                    style="-fx-background-color: transparent; -fx-padding: 0;
                                    -fx-font-size: 11;"
                    verticalGridLinesVisible="true"
                    horizontalGridLinesVisible="true">
                    <xAxis>
                      <NumberAxis fx:id="axisChartX" side="BOTTOM" label="Mốc (bid)" />
                    </xAxis>
                    <yAxis>
                      <NumberAxis fx:id="axisChartY" side="LEFT" label="Giá (VNĐ)" />
                    </yAxis>
                  </LineChart>
                </VBox>
                <!-- END CHART -->


                <!-- ┌─ LIVE BID HISTORY ──────────────────────────────────┐ -->
                <VBox spacing="0.0"
                  style="-fx-background-color: white;
                             -fx-background-radius: 18;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),20,0,0,4);">

                  <!-- Header -->
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="16.0" /></padding>
                    <Label style="-fx-text-fill: #202124; -fx-font-weight: bold;"
                      text="Lịch sử đấu giá">
                      <font><Font size="15.0" /></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox alignment="CENTER" spacing="4.0">
                      <Circle fill="#FF4444" radius="4.5" />
                      <Label style="-fx-text-fill: #FF4444; -fx-font-size: 11;
                                    -fx-font-weight: bold;" text="Trực tiếp">
                        <font><Font size="11.0" /></font>
                      </Label>
                    </HBox>
                  </HBox>

                  <!-- Column headers -->
                  <HBox style="-fx-background-color: #F4F7FC;">
                    <padding><Insets bottom="8.0" left="18.0" right="18.0" top="8.0" /></padding>
                    <Label prefWidth="88.0"
                      style="-fx-text-fill: #888888; -fx-font-size: 11;
                                  -fx-font-weight: bold;" text="Thời gian">
                      <font><Font size="11.0" /></font>
                    </Label>
                    <Label prefWidth="110.0"
                      style="-fx-text-fill: #888888; -fx-font-size: 11;
                                  -fx-font-weight: bold;" text="Người dùng">
                      <font><Font size="11.0" /></font>
                    </Label>
                    <Label style="-fx-text-fill: #888888; -fx-font-size: 11;
                                  -fx-font-weight: bold;" text="Số tiền">
                      <font><Font size="11.0" /></font>
                    </Label>
                  </HBox>

                  <!-- Dynamic bid rows — populated by BidHistoryController -->
                  <ScrollPane fx:id="scrollHistory"
                    fitToWidth="true" maxHeight="260.0"
                    style="-fx-background: transparent;
                                     -fx-background-color: transparent;
                                     -fx-border-color: transparent;">
                    <content>
                      <VBox fx:id="vboxBidHistory" spacing="0.0"
                        style="-fx-background-color: white;">
                        <!-- Được controller điền động — placeholder khi chưa load -->
                        <Label style="-fx-text-fill: #AAAAAA; -fx-font-size: 13px;
                                      -fx-padding: 16;"
                          text="⏳ Đang tải lịch sử..." />
                      </VBox>
                    </content>
                  </ScrollPane>
                </VBox>
                <!-- END BID HISTORY -->


                <!-- ┌─ USER STATUS BANNER ────────────────────────────────┐ -->
                <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #FFF8E1;
                             -fx-background-radius: 14;
                             -fx-border-color: #FFCA28;
                             -fx-border-radius: 14;
                             -fx-border-width: 1;">
                  <padding><Insets bottom="14.0" left="16.0" right="16.0" top="14.0" /></padding>
                  <Label style="-fx-font-size: 22;" text="🔒"/>
                  <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label style="-fx-text-fill: #795548; -fx-font-size: 12;
                                  -fx-font-weight: bold;"
                      text="Số tiền đặt trước của bạn đã được khóa." wrapText="true"/>
                    <Label style="-fx-text-fill: #34A853; -fx-font-size: 12;
                                  -fx-font-weight: bold;"
                      text="Bạn đủ điều kiện tham gia."/>
                  </VBox>
                  <Label style="-fx-font-size: 24; -fx-cursor: hand;" text="🇻🇳"/>
                </HBox>

              </VBox>
              <!-- END RIGHT COLUMN -->

            </HBox>
          </VBox>
        </content>
      </ScrollPane>

    </VBox>
  </children>
</AnchorPane>
