<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<!--
  ╔══════════════════════════════════════════════════════════╗
  ║     GEMINI — Live Auction Room  (AnchorPane 1280×900)    ║
  ║     Controller: com.nhom15.client.controller             ║
  ║                 .AuctionRoomController                   ║
  ╚══════════════════════════════════════════════════════════╝

  fx:id catalogue
  ──────────────────────────────────────────────────────────
  lblCountdown        — real-time HH:MM:SS countdown label
  lblSoftClose        — soft-close tooltip / sub-caption
  lblCurrentBid       — highest bid amount (e.g. $15,800 USD)
  lblBidStatus        — "Mức giá sàn đã đạt" status label
  txtCustomBid        — free-text custom bid input field
  btnQuickBid1/2/3    — +$500 / +$1,000 / +$2,500 quick buttons
  btnConfirmBid       — primary "Xác nhận đặt giá" CTA
  btnPlaceBid         — secondary "Đặt giá ngay" CTA
  rowWinning          — green-highlighted winning bid row HBox
  paneBackground      — animated background pane (code-driven)
  btnLogin / btnRegister inherited from LoginController FXML pattern
-->

<AnchorPane fx:id="rootPane" prefHeight="900.0" prefWidth="1280.0" style="-fx-background-color: #F4F7FC;" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom15.client.controller.AuctionRoomController">

  <children>

    <!-- ░░░ ANIMATED BACKGROUND LAYER ░░░ -->
    <Pane fx:id="paneBackground" mouseTransparent="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

    <!-- ░░░ ROOT VERTICAL STACK ░░░ -->
    <VBox spacing="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

      <!-- ══════════════════════════════════════════════════════
           SECTION 1 ▸ HEADER / NAVIGATION BAR
           ══════════════════════════════════════════════════════ -->
      <HBox fx:id="headerBar" alignment="CENTER_LEFT" prefHeight="64.0" spacing="0.0" style="-fx-background-color: white;                  -fx-border-color: transparent transparent #E8EAED transparent;                  -fx-border-width: 0 0 1 0;">
        <padding>
          <Insets left="28.0" right="28.0" />
        </padding>

        <!-- ── Logo cluster ── -->
        <HBox alignment="CENTER_LEFT" spacing="7.0">

          <!-- ◀ Nút Quay lại -->
          <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBack"
                  style="-fx-background-color: #F4F7FC;
                         -fx-text-fill: #4285F4;
                         -fx-cursor: hand;
                         -fx-font-size: 13;
                         -fx-font-weight: bold;
                         -fx-background-radius: 20;
                         -fx-border-color: #4285F4;
                         -fx-border-radius: 20;
                         -fx-border-width: 1.5;"
                  text="◀ Quay lại">
            <font><Font size="13.0" /></font>
          </Button>

          <!-- Multi-colour star mark (gradient approximated via layered labels) -->
          <StackPane prefHeight="28.0" prefWidth="28.0">
                  <children>
                     <ImageView fitHeight="68.0" fitWidth="158.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../images/Google-Gemini-Logo.png" />
                        </image></ImageView>
                  </children>
          </StackPane>
        </HBox>

        <!-- ── Spacer ── -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- ── Nav links ── -->
        <HBox alignment="CENTER" spacing="4.0">
          <Button mnemonicParsing="false" style="-fx-background-color: transparent;                          -fx-text-fill: #202124;                          -fx-cursor: hand;                          -fx-font-size: 13.5;">
            <font><Font size="13.5" /></font>
          </Button>
          <Button mnemonicParsing="false" style="-fx-background-color: transparent;                          -fx-text-fill: #202124;                          -fx-cursor: hand;                          -fx-font-size: 13.5;">
            <font><Font size="13.5" /></font>
          </Button>
        </HBox>

        <!-- ── Spacer ── -->
        <Region HBox.hgrow="ALWAYS" />

        <!-- ── Social icons + CTA ── -->
        <HBox alignment="CENTER" spacing="18.0">
          <!-- Instagram -->
          <Label style="-fx-text-fill: #606368;                         -fx-font-size: 18;                         -fx-cursor: hand;">
            <font><Font size="18.0" /></font>
          </Label>
          <!-- TikTok -->
          <Label style="-fx-text-fill: #606368;                         -fx-font-size: 18;                         -fx-cursor: hand;">
            <font><Font size="18.0" /></font>
          </Label>
          <!-- Discord -->
          <Label style="-fx-text-fill: #606368;                         -fx-font-size: 18;                         -fx-cursor: hand;">
            <font><Font size="18.0" /></font>
          </Label>
          <!-- X / Twitter -->
          <Label style="-fx-text-fill: #606368;                         -fx-font-size: 18;                         -fx-cursor: hand;" text="✕">
            <font><Font size="18.0" /></font>
          </Label>
        </HBox>

      </HBox>
      <!-- END HEADER -->


      <!-- ══════════════════════════════════════════════════════
           SECTION 2 ▸ LIVE STATUS RIBBON
           ══════════════════════════════════════════════════════ -->
      <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="12.0" style="-fx-background-color: white;                  -fx-border-color: transparent transparent #E8EAED transparent;                  -fx-border-width: 0 0 1 0;">
        <padding>
          <Insets left="28.0" right="28.0" />
        </padding>

        <!-- LIVE pill -->
        <StackPane>
          <Rectangle arcHeight="14.0" arcWidth="14.0" fill="#FF4444" height="24.0" width="64.0" />
          <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="● LIVE" textFill="white">
            <font><Font size="11.0" /></font>
          </Label>
        </StackPane>

        <Label style="-fx-text-fill: #606368; -fx-font-size: 13;" text="Phiên đấu giá đang diễn ra · Lot 12">
          <font><Font size="13.0" /></font>
        </Label>

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="lblViewerCount" style="-fx-text-fill: #888888; -fx-font-size: 12;" text="👥  -- người đang xem">
          <font><Font size="12.0" /></font>
        </Label>
      </HBox>
      <!-- END RIBBON -->


      <!-- ══════════════════════════════════════════════════════
           SECTION 3 ▸ SCROLLABLE MAIN CONTENT
           ══════════════════════════════════════════════════════ -->
      <ScrollPane fitToWidth="true" style="-fx-background-color: #F4F7FC;                  -fx-background: #F4F7FC;                  -fx-border-color: transparent;" VBox.vgrow="ALWAYS">

        <content>

          <VBox spacing="0.0" style="-fx-background-color: #F4F7FC;">
            <padding>
              <Insets bottom="48.0" left="40.0" right="40.0" top="28.0" />
            </padding>

            <!-- ┌────────────────────────────────────────────────────┐ -->
            <!-- │         TWO-COLUMN AUCTION LAYOUT                  │ -->
            <!-- └────────────────────────────────────────────────────┘ -->
            <HBox spacing="24.0" VBox.vgrow="ALWAYS">

              <!-- ═══════════════════════════════════════════════════
                   LEFT COLUMN  ▸ Product Gallery + Info
                   ═══════════════════════════════════════════════════ -->
              <VBox spacing="18.0" HBox.hgrow="ALWAYS">

                <!-- ── Main Watch Image Card ── -->
                <StackPane prefHeight="360.0" style="-fx-background-color: white;                                   -fx-background-radius: 18;                                   -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),24,0,0,6);">

                  <!-- Background gradient shimmer -->
                  <!-- Decorative ring behind watch -->
                  <Circle fill="transparent" opacity="0.5" radius="130.0" stroke="#E8EAED" strokeWidth="1.0" />

                  <!-- Watch emoji placeholder — ẩn khi có ảnh thực -->
                  <Label fx:id="lblImgPlaceholder" style="-fx-font-size: 160; -fx-opacity: 0.92;" text="⌚" />

                  <!-- Ảnh sản phẩm thực — controller sẽ set ảnh và setVisible(true) -->
                  <ImageView fx:id="imgProduct"
                             fitHeight="340.0" fitWidth="600.0"
                             pickOnBounds="true" preserveRatio="true"
                             visible="false" />

                  <!-- LOT badge -->
                  <StackPane StackPane.alignment="TOP_LEFT">
                    <Rectangle arcHeight="0.0" arcWidth="0.0" fill="#4285F4" height="28.0" width="72.0" />
                    <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="LOT 12" textFill="white">
                      <font><Font size="11.0" /></font>
                    </Label>
                  </StackPane>

                  <!-- Gemini accent star (top-right) -->
                  <Label style="-fx-text-fill: #9B72CB;                                 -fx-font-size: 22;                                 -fx-opacity: 0.4;" text="✦" StackPane.alignment="TOP_RIGHT">
                    <StackPane.margin><Insets right="16.0" top="12.0" /></StackPane.margin>
                  </Label>

                  <!-- Zoom hint -->
                  <Label style="-fx-font-size: 18; -fx-opacity: 0.6; -fx-cursor: hand;" text="🔍" StackPane.alignment="BOTTOM_RIGHT">
                    <StackPane.margin><Insets bottom="14.0" right="16.0" /></StackPane.margin>
                  </Label>
                </StackPane>

                <!-- ── Thumbnail Strip ── -->
                <HBox spacing="10.0">
                  <!-- Thumb 1 — active / selected -->
                  <StackPane prefHeight="68.0" prefWidth="68.0" style="-fx-background-color: #EEF3FE;                                     -fx-background-radius: 10;                                     -fx-border-color: #4285F4;                                     -fx-border-radius: 10;                                     -fx-border-width: 2.5;                                     -fx-cursor: hand;">
                    <Label style="-fx-font-size: 30;" text="⌚" />
                  </StackPane>
                  <!-- Thumb 2 -->
                  <StackPane prefHeight="68.0" prefWidth="68.0" style="-fx-background-color: white;                                     -fx-background-radius: 10;                                     -fx-border-color: #E8EAED;                                     -fx-border-radius: 10;                                     -fx-border-width: 1;                                     -fx-cursor: hand;">
                    <Label style="-fx-font-size: 26; -fx-opacity: 0.65;" text="⌚" />
                  </StackPane>
                  <!-- Thumb 3 -->
                  <StackPane prefHeight="68.0" prefWidth="68.0" style="-fx-background-color: white;                                     -fx-background-radius: 10;                                     -fx-border-color: #E8EAED;                                     -fx-border-radius: 10;                                     -fx-border-width: 1;                                     -fx-cursor: hand;">
                    <Label style="-fx-font-size: 26; -fx-opacity: 0.65;" text="⌚" />
                  </StackPane>
                  <!-- Thumb 4 -->
                  <StackPane prefHeight="68.0" prefWidth="68.0" style="-fx-background-color: white;                                     -fx-background-radius: 10;                                     -fx-border-color: #E8EAED;                                     -fx-border-radius: 10;                                     -fx-border-width: 1;                                     -fx-cursor: hand;">
                    <Label style="-fx-font-size: 26; -fx-opacity: 0.65;" text="⌚" />
                  </StackPane>
                  <!-- Thumb 5 -->
                  <StackPane prefHeight="68.0" prefWidth="68.0" style="-fx-background-color: white;                                     -fx-background-radius: 10;                                     -fx-border-color: #E8EAED;                                     -fx-border-radius: 10;                                     -fx-border-width: 1;                                     -fx-cursor: hand;">
                    <Label style="-fx-font-size: 26; -fx-opacity: 0.65;" text="⌚" />
                  </StackPane>
                </HBox>

                <!-- ── Product Information Card ── -->
                <VBox spacing="14.0" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.06),20,0,0,4);">
                  <padding>
                    <Insets bottom="26.0" left="26.0" right="26.0" top="26.0" />
                  </padding>

                  <!-- Title -->
                  <Label fx:id="lblProductName" style="-fx-text-fill: #202124;                                 -fx-font-weight: bold;" text="Đang tải..." wrapText="true">
                    <font><Font name="Arial" size="20.0" /></font>
                  </Label>

                  <!-- Description -->
                  <Label fx:id="lblProductDesc" style="-fx-text-fill: #606368; -fx-line-spacing: 3;" text="" wrapText="true">
                    <font><Font size="13.5" /></font>
                  </Label>

                  <!-- Verified Badge -->
                  <HBox alignment="CENTER_LEFT" spacing="0.0">
                    <VBox.margin><Insets top="2.0" /></VBox.margin>
                    <StackPane>
                      <Rectangle arcHeight="22.0" arcWidth="22.0" fill="#E8F5E9" height="34.0" width="226.0" />
                      <HBox alignment="CENTER_LEFT" spacing="7.0">
                        <padding>
                          <Insets left="13.0" right="13.0" />
                        </padding>
                        <Label style="-fx-text-fill: #34A853;                                       -fx-font-weight: bold;                                       -fx-font-size: 14;" text="✓">
                          <font><Font size="14.0" /></font>
                        </Label>
                        <Label style="-fx-text-fill: #34A853;                                       -fx-font-size: 13;                                       -fx-font-weight: bold;" text="Đã xác minh tính xác thực">
                          <font><Font size="13.0" /></font>
                        </Label>
                      </HBox>
                    </StackPane>
                  </HBox>

                  <Separator style="-fx-opacity: 0.4;" />

                  <!-- Specs Grid (2×2) -->
                  <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints percentWidth="50.0" />
                      <ColumnConstraints percentWidth="50.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints />
                      <RowConstraints />
                    </rowConstraints>

                    <!-- Cell: Brand -->
                    <VBox spacing="3.0" style="-fx-background-color: #F4F7FC; -fx-background-radius: 10;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                      <padding><Insets bottom="11.0" left="13.0" right="13.0" top="11.0" /></padding>
                      <Label style="-fx-text-fill: #888888; -fx-font-size: 11;" text="Thương hiệu">
                        <font><Font size="11.0" /></font>
                      </Label>
                      <Label style="-fx-text-fill: #202124;                                     -fx-font-weight: bold;                                     -fx-font-size: 14;" text="Patek Philippe">
                        <font><Font size="14.0" /></font>
                      </Label>
                    </VBox>

                    <!-- Cell: Model -->
                    <VBox spacing="3.0" style="-fx-background-color: #F4F7FC; -fx-background-radius: 10;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                      <padding><Insets bottom="11.0" left="13.0" right="13.0" top="11.0" /></padding>
                      <Label style="-fx-text-fill: #888888; -fx-font-size: 11;" text="Model">
                        <font><Font size="11.0" /></font>
                      </Label>
                      <Label style="-fx-text-fill: #202124;                                     -fx-font-weight: bold;                                     -fx-font-size: 14;" text="Calatrava 5119J">
                        <font><Font size="14.0" /></font>
                      </Label>
                    </VBox>

                    <!-- Cell: Year -->
                    <VBox spacing="3.0" style="-fx-background-color: #F4F7FC; -fx-background-radius: 10;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                      <padding><Insets bottom="11.0" left="13.0" right="13.0" top="11.0" /></padding>
                      <Label style="-fx-text-fill: #888888; -fx-font-size: 11;" text="Năm sản xuất">
                        <font><Font size="11.0" /></font>
                      </Label>
                      <Label style="-fx-text-fill: #202124;                                     -fx-font-weight: bold;                                     -fx-font-size: 14;" text="2008">
                        <font><Font size="14.0" /></font>
                      </Label>
                    </VBox>

                    <!-- Cell: Condition -->
                    <VBox spacing="3.0" style="-fx-background-color: #F4F7FC; -fx-background-radius: 10;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                      <padding><Insets bottom="11.0" left="13.0" right="13.0" top="11.0" /></padding>
                      <Label style="-fx-text-fill: #888888; -fx-font-size: 11;" text="Tình trạng">
                        <font><Font size="11.0" /></font>
                      </Label>
                      <Label style="-fx-text-fill: #202124;                                     -fx-font-weight: bold;                                     -fx-font-size: 14;" text="Xuất sắc ★★★★★">
                        <font><Font size="14.0" /></font>
                      </Label>
                    </VBox>
                  </GridPane>

                </VBox>
                <!-- END PRODUCT INFO CARD -->

                <!-- ── Related Lots Section ── -->
                <VBox spacing="12.0">
                  <Label style="-fx-text-fill: #202124; -fx-font-weight: bold;" text="Các lot liên quan">
                    <font><Font size="17.0" /></font>
                  </Label>

                  <HBox spacing="12.0">

                    <!-- Related Lot 1 -->
                    <VBox spacing="8.0" style="-fx-background-color: white;                                  -fx-background-radius: 14;                                  -fx-cursor: hand;                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),12,0,0,2);" HBox.hgrow="ALWAYS">
                      <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0" /></padding>
                      <Label style="-fx-font-size: 40;" text="⌚" />
                      <Label style="-fx-text-fill: #202124;                                     -fx-font-size: 12;                                     -fx-font-weight: bold;" text="Lot 12: Đồng hồ Patek Philippe Calatrava Cổ điển" wrapText="true">
                        <font><Font size="12.0" /></font>
                      </Label>
                      <Label style="-fx-text-fill: #4285F4;                                     -fx-font-size: 12;                                     -fx-cursor: hand;" text="Link thành link →">
                        <font><Font size="12.0" /></font>
                      </Label>
                    </VBox>

                    <!-- Related Lot 2 -->
                    <VBox spacing="8.0" style="-fx-background-color: white;                                  -fx-background-radius: 14;                                  -fx-cursor: hand;                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),12,0,0,2);" HBox.hgrow="ALWAYS">
                      <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0" /></padding>
                      <Label style="-fx-font-size: 40;" text="⌚" />
                      <Label style="-fx-text-fill: #202124;                                     -fx-font-size: 12;                                     -fx-font-weight: bold;" text="Lot 13: Đồng hồ Patek Philippe Calatrava Cổ điển" wrapText="true">
                        <font><Font size="12.0" /></font>
                      </Label>
                      <Label style="-fx-text-fill: #4285F4;                                     -fx-font-size: 12;                                     -fx-cursor: hand;" text="Link thính link →">
                        <font><Font size="12.0" /></font>
                      </Label>
                    </VBox>

                    <!-- Related Lot 3 -->
                    <VBox spacing="8.0" style="-fx-background-color: white;                                  -fx-background-radius: 14;                                  -fx-cursor: hand;                                  -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),12,0,0,2);" HBox.hgrow="ALWAYS">
                      <padding><Insets bottom="14.0" left="14.0" right="14.0" top="14.0" /></padding>
                      <Label style="-fx-font-size: 40;" text="⌚" />
                      <Label style="-fx-text-fill: #202124;                                     -fx-font-size: 12;                                     -fx-font-weight: bold;" text="Lot 14: Đồng hồ Patek Philippe Calatrava Cổ điển" wrapText="true">
                        <font><Font size="12.0" /></font>
                      </Label>
                      <Label style="-fx-text-fill: #4285F4;                                     -fx-font-size: 12;                                     -fx-cursor: hand;" text="Link thính link →">
                        <font><Font size="12.0" /></font>
                      </Label>
                    </VBox>

                  </HBox>
                </VBox>

              </VBox>
              <!-- END LEFT COLUMN -->


              <!-- ═══════════════════════════════════════════════════
                   RIGHT COLUMN  ▸ Auction Control Panel
                   Fixed width 370px — the financial trading panel
                   ═══════════════════════════════════════════════════ -->
              <VBox minWidth="350.0" prefWidth="370.0" spacing="16.0">

                <!-- Panel title + star accent -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                  <Label style="-fx-text-fill: #9B72CB;                                 -fx-font-size: 16;" text="✦">
                    <font><Font size="16.0" /></font>
                  </Label>
                  <Label style="-fx-text-fill: #202124;                                 -fx-font-weight: bold;" text="Auction Control Panel">
                    <font><Font size="18.0" /></font>
                  </Label>
                </HBox>


                <!-- ┌──────────────────────────────────────────────┐ -->
                <!-- │  COUNTDOWN TIMER + CURRENT BID CARD          │ -->
                <!-- └──────────────────────────────────────────────┘ -->
                <VBox spacing="0.0" style="-fx-background-color: white;                              -fx-background-radius: 18;                              -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.09),24,0,0,6);">

                  <!-- ▌TIMER section — GIF nền inject bởi controller qua MediaView ▌ -->
                  <StackPane fx:id="timerPane" prefHeight="116.0"
                             style="-fx-background-color: #1a1a2e;
                                       -fx-background-radius: 18 18 0 0;">

                    <Circle fill="transparent" opacity="0.15" radius="44.0" stroke="white" strokeWidth="1.0" />

                    <VBox alignment="CENTER" spacing="5.0">
                      <Label fx:id="lblCountdown" style="-fx-font-weight: bold;                                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.25),8,0,0,3);" text="00:00:24" textFill="white">
                        <font><Font size="54.0" /></font>
                      </Label>

                      <HBox alignment="CENTER" spacing="5.0">
                        <Label style="-fx-font-size: 11; -fx-opacity: 0.9;" text="⚠" textFill="white">
                          <font><Font size="11.0" /></font>
                        </Label>
                        <Label fx:id="lblSoftClose" style="-fx-font-size: 11; -fx-opacity: 0.9;" text="Luật Soft Close — Đếm ngược 30 giây" textFill="white">
                          <font><Font size="11.0" /></font>
                        </Label>
                      </HBox>
                    </VBox>

                    <Circle fx:id="dotPulse" fill="#FF3333" radius="5.5" StackPane.alignment="TOP_RIGHT">
                      <StackPane.margin>
                        <Insets right="14.0" top="13.0" />
                      </StackPane.margin>
                    </Circle>
                  </StackPane>
                  <!-- END TIMER -->

                  <!-- ▌CURRENT BID section ▌ -->
                  <VBox alignment="CENTER" spacing="4.0" style="-fx-background-color: white;                                -fx-background-radius: 0 0 18 18;">
                    <padding>
                      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>

                    <Label style="-fx-text-fill: #888888; -fx-font-size: 12.5;" text="Mức giá cao nhất hiện tại">
                      <font><Font size="40.0" /></font>
                    </Label>

                    <Label fx:id="lblCurrentBid" style="-fx-text-fill: #1A73E8;                                   -fx-font-weight: bold;" text="">
                      <font><Font size="36.0" /></font>
                    </Label>

                    <HBox alignment="CENTER" spacing="5.0">
                      <Label style="-fx-text-fill: #34A853;                                     -fx-font-weight: bold;                                     -fx-font-size: 12;" text="✓">
                        <font><Font size="12.0" /></font>
                      </Label>
                      <Label fx:id="lblBidStatus" style="-fx-text-fill: #34A853;                                     -fx-font-size: 12.5;                                     -fx-font-weight: bold;" text="Mức giá sàn đã đạt">
                        <font><Font size="12.5" /></font>
                      </Label>
                    </HBox>
                  </VBox>

                </VBox>
                <!-- END TIMER+BID CARD -->


                <!-- ┌──────────────────────────────────────────────┐ -->
                <!-- │  BIDDING CONTROLS CARD                        │ -->
                <!-- └──────────────────────────────────────────────┘ -->
