<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.*?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<BorderPane
  prefHeight="820" prefWidth="1320"
  style="-fx-background-color: linear-gradient(to bottom right, #F0F4FF, #FAF0FF, #FFF0F8);"
  xmlns:fx="http://javafx.com/fxml/1"
  xmlns="http://javafx.com/javafx/17.0.12"
  fx:controller="com.nhom15.client.controller.BiddingRoomController">

  <!-- ══════════════════════════ STYLESHEET ══════════════════════════ -->
  <stylesheets>
    <String fx:value="@/css/bidding-room.css"/>
  </stylesheets>

  <!-- ══════════════════════════ TOP BAR ══════════════════════════════ -->
  <top>
    <VBox>
      <!-- Main navbar -->
      <HBox alignment="CENTER_LEFT" spacing="14"
        style="-fx-background-color: white;
                   -fx-padding: 14 28 14 28;
                   -fx-effect: dropshadow(gaussian,rgba(102,51,204,0.12),16,0,0,4);
                   -fx-border-color: #A78BFA;
                   -fx-border-width: 0 0 2 0;">

        <!-- Back button -->
        <Button onAction="#handleBack"
          style="-fx-background-color: linear-gradient(to right,#EDE9FE,#FCE7F3);
                       -fx-background-radius: 10;
                       -fx-padding: 7 16 7 16;
                       -fx-cursor: hand;
                       -fx-font-size: 12px;
                       -fx-text-fill: #7C3AED;
                       -fx-font-weight: bold;
                       -fx-effect: dropshadow(gaussian,rgba(124,58,237,0.15),6,0,0,2);"
          text="← Quay lại" />

        <!-- Title with gradient feel -->
        <Label fx:id="lblTitle"
          style="-fx-font-size: 18px; -fx-font-weight: bold;
                      -fx-text-fill: #4C1D95;"
          text="🏛️ Phòng đấu giá" />

        <!-- Room ID badge -->
        <Label fx:id="lblRoomId"
          style="-fx-background-color: linear-gradient(to right,#7C3AED,#A855F7);
                      -fx-text-fill: white; -fx-background-radius: 20;
                      -fx-padding: 3 12 3 12; -fx-font-size: 10px;
                      -fx-font-weight: bold;" text="#---" />

        <Region HBox.hgrow="ALWAYS" />

        <!-- Viewer count -->
        <HBox spacing="5" alignment="CENTER"
          style="-fx-background-color: #FEF3C7; -fx-background-radius: 20;
                     -fx-padding: 5 12 5 12;">
          <Label style="-fx-font-size: 11px; -fx-text-fill: #92400E;" text="👁" />
          <Label fx:id="lblViewers"
            style="-fx-font-size: 11px; -fx-text-fill: #92400E; -fx-font-weight: bold;"
            text="0 đang xem" />
        </HBox>

        <!-- Anti-snipe alert -->
        <Label fx:id="lblAntiSnipe"
          style="-fx-background-color: linear-gradient(to right,#FEF3C7,#FDE68A);
                      -fx-text-fill: #92400E;
                      -fx-background-radius: 10; -fx-padding: 6 14 6 14;
                      -fx-font-size: 11px; -fx-font-weight: bold;
                      -fx-effect: dropshadow(gaussian,rgba(245,158,11,0.3),8,0,0,2);"
          visible="false" />

        <!-- Watchlist button -->
        <Button fx:id="btnWatchlist" onAction="#handleToggleWatchlist"
          style="-fx-background-color: linear-gradient(to right,#ECFDF5,#D1FAE5);
                       -fx-text-fill: #065F46; -fx-background-radius: 10;
                       -fx-padding: 6 14 6 14; -fx-cursor: hand;
                       -fx-font-size: 11px; -fx-font-weight: bold;"
          text="☆ Theo dõi" />

        <!-- Share button -->
        <Button onAction="#handleShare"
          style="-fx-background-color: linear-gradient(to right,#EFF6FF,#DBEAFE);
                       -fx-text-fill: #1E40AF; -fx-background-radius: 10;
                       -fx-padding: 6 14 6 14; -fx-cursor: hand;
                       -fx-font-size: 11px;"
          text="🔗 Chia sẻ" />

        <!-- Status badge -->
        <Label fx:id="lblStatus"
          style="-fx-background-color: linear-gradient(to right,#DCFCE7,#BBF7D0);
                      -fx-text-fill: #166534;
                      -fx-background-radius: 20; -fx-padding: 5 16 5 16;
                      -fx-font-weight: bold; -fx-font-size: 11px;
                      -fx-effect: dropshadow(gaussian,rgba(22,163,74,0.2),6,0,0,2);"
          text="● ACTIVE" />
      </HBox>

      <!-- Progress bar (thời gian còn lại dạng bar) -->
      <ProgressBar fx:id="progressTime" maxWidth="Infinity" prefHeight="4" progress="1.0"
        style="-fx-accent: linear-gradient(to right,#8B5CF6,#EC4899,#3B82F6);
                          -fx-background-color: #F3F4F6;" />
    </VBox>
  </top>

  <!-- ══════════════════════════ CENTER ══════════════════════════════ -->
  <center>
    <HBox spacing="14" style="-fx-padding: 16 18 16 18;">

      <!-- ════════ LEFT: Sản phẩm ════════ -->
      <VBox prefWidth="340" spacing="0"
        style="-fx-background-color: white;
                   -fx-background-radius: 18;
                   -fx-effect: dropshadow(gaussian,rgba(99,102,241,0.1),20,0,0,6);">

        <!-- Ảnh sản phẩm với gradient overlay -->
        <StackPane prefHeight="230"
          style="-fx-background-color: linear-gradient(to bottom,#EDE9FE,#FCE7F3);
                          -fx-background-radius: 18 18 0 0;">
          <ImageView fx:id="imgProduct" fitHeight="230" fitWidth="340" preserveRatio="true">
            <effect>
              <javafx.scene.effect.DropShadow color="rgba(0,0,0,0.08)" radius="8"/>
            </effect>
          </ImageView>
          <Label fx:id="lblImgPlaceholder"
            style="-fx-font-size: 56px; -fx-text-fill: #C4B5FD;"
            text="🖼️" />

          <!-- Badge góc trên phải -->
          <VBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT"
            style="-fx-padding: 10 10 0 0;">
            <Label fx:id="lblCondition"
              style="-fx-background-color: rgba(124,58,237,0.85);
                          -fx-text-fill: white; -fx-background-radius: 8;
                          -fx-padding: 3 10 3 10; -fx-font-size: 10px;
                          -fx-font-weight: bold;"
              text="Mới 100%" />
          </VBox>
        </StackPane>

        <!-- Thông tin sản phẩm -->
        <VBox spacing="10" style="-fx-padding: 16 18 16 18;">

          <Label fx:id="lblProductName"
            style="-fx-font-size: 16px; -fx-font-weight: bold;
                        -fx-text-fill: #1E1B4B; -fx-wrap-text: true;" />

          <HBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="lblCategory"
              style="-fx-font-size: 10px; -fx-text-fill: #7C3AED;
                          -fx-background-color: #EDE9FE; -fx-background-radius: 6;
                          -fx-padding: 3 10 3 10; -fx-font-weight: bold;" />
            <Label fx:id="lblCondition2"
              style="-fx-font-size: 10px; -fx-text-fill: #0891B2;
                          -fx-background-color: #E0F2FE; -fx-background-radius: 6;
                          -fx-padding: 3 10 3 10;" text="✓ Xác thực" />
          </HBox>

          <Label fx:id="lblDescription"
            maxWidth="300"
            style="-fx-font-size: 12px; -fx-text-fill: #6B7280;
                        -fx-wrap-text: true; -fx-line-spacing: 3;" />

          <!-- Divider -->
          <Separator style="-fx-background-color: #F3F4F6;" />

          <!-- Seller info card -->
          <HBox spacing="10" alignment="CENTER_LEFT"
            style="-fx-background-color: linear-gradient(to right,#F9FAFB,#F3F4F6);
                       -fx-background-radius: 10; -fx-padding: 10 12;">
            <StackPane>
              <Circle fx:id="avatarCircle" fill="#A78BFA" radius="18" />
              <Label fx:id="lblAvatarInitial"
                style="-fx-font-size: 14px; -fx-text-fill: white;
                            -fx-font-weight: bold;" text="?" />
            </StackPane>
            <VBox spacing="2">
              <Label fx:id="lblSeller"
                style="-fx-font-size: 12px; -fx-font-weight: bold;
                            -fx-text-fill: #374151;" />
              <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
                text="⭐ 4.9 · 128 phiên đấu giá" />
            </VBox>
          </HBox>

          <!-- Giá khởi điểm -->
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"
              text="Giá khởi điểm:" />
            <Label fx:id="lblStartPrice"
              style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #6B7280;" />
          </HBox>

          <!-- Reserve price indicator -->
          <ProgressBar fx:id="progressReserve" maxWidth="Infinity" prefHeight="6"
            progress="0.4"
            style="-fx-accent: linear-gradient(to right,#F59E0B,#10B981);
                              -fx-background-radius: 4;" />
          <Label fx:id="lblReserveHint"
            style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
            text="📊 40% đến giá đặt trước" />

        </VBox>
      </VBox>

      <!-- ════════ MIDDLE: Bidding area ════════ -->
      <VBox spacing="12" HBox.hgrow="ALWAYS">

        <!-- Stats row -->
        <HBox spacing="12">

          <!-- Giá hiện tại -->
          <VBox alignment="CENTER" spacing="4"
            style="-fx-background-color: white;
                       -fx-background-radius: 16;
                       -fx-padding: 18 14 18 14;
                       -fx-effect: dropshadow(gaussian,rgba(236,72,153,0.12),16,0,0,5);
                       -fx-border-color: #FDE8EF;
                       -fx-border-radius: 16; -fx-border-width: 1.5;"
            HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;
                          -fx-font-weight: bold;"
              text="💰 GIÁ HIỆN TẠI" />
            <Label fx:id="lblCurrentPrice"
              style="-fx-font-size: 30px; -fx-font-weight: bold;
                          -fx-text-fill: #DB2777;" text="---" />
            <Label fx:id="lblPriceChange"
              style="-fx-font-size: 11px; -fx-text-fill: #10B981;
                          -fx-background-color: #ECFDF5; -fx-background-radius: 6;
                          -fx-padding: 2 8;" text="▲ +0đ" />
            <Label fx:id="lblLeader"
              style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"
              text="Chưa có ai dẫn đầu" />
          </VBox>

          <!-- Đồng hồ -->
          <VBox alignment="CENTER" spacing="4"
            style="-fx-background-color: white;
                       -fx-background-radius: 16;
                       -fx-padding: 18 14 18 14;
                       -fx-effect: dropshadow(gaussian,rgba(59,130,246,0.12),16,0,0,5);
                       -fx-border-color: #DBEAFE;
                       -fx-border-radius: 16; -fx-border-width: 1.5;"
            HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;
                          -fx-font-weight: bold;"
              text="⏱ THỜI GIAN CÒN LẠI" />
            <Label fx:id="lblCountdown"
              style="-fx-font-size: 26px; -fx-font-weight: bold;
                          -fx-text-fill: #2563EB; -fx-font-family: 'Courier New';"
              text="--:--:--" />
            <Label fx:id="lblTotalBids"
              style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"
              text="0 lượt đặt" />
          </VBox>

          <!-- My budget card -->
          <VBox alignment="CENTER" spacing="4"
            style="-fx-background-color: white;
                       -fx-background-radius: 16;
                       -fx-padding: 18 14 18 14;
                       -fx-effect: dropshadow(gaussian,rgba(124,58,237,0.12),16,0,0,5);
                       -fx-border-color: #EDE9FE;
                       -fx-border-radius: 16; -fx-border-width: 1.5;"
            HBox.hgrow="ALWAYS">
            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;
                          -fx-font-weight: bold;"
              text="💎 NGÂN SÁCH CỦA BẠN" />
            <Label fx:id="lblMyBudget"
              style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: #7C3AED;" text="---" />
            <ProgressBar fx:id="progressBudget" maxWidth="120" prefHeight="5"
              progress="0.0"
              style="-fx-accent: #7C3AED; -fx-background-radius: 4;" />
            <Label fx:id="lblBudgetUsed"
              style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
              text="0% ngân sách đã dùng" />
          </VBox>

        </HBox>

        <!-- Main TabPane -->
        <TabPane fx:id="tabPane"
          style="-fx-background-color: white; -fx-background-radius: 18;
                        -fx-effect: dropshadow(gaussian,rgba(99,102,241,0.08),20,0,0,6);"
          tabClosingPolicy="UNAVAILABLE"
          VBox.vgrow="ALWAYS">

          <!-- ┌──────────────────────────────────┐ -->
          <!-- │  TAB 1: Đặt giá thủ công         │ -->
          <!-- └──────────────────────────────────┘ -->
          <Tab fx:id="tabManual" text="🔨 Đặt giá">
            <VBox spacing="14" style="-fx-background-color: white;
                                      -fx-padding: 20 24;
                                      -fx-background-radius: 0 0 18 18;">

              <Label style="-fx-font-size: 15px; -fx-font-weight: bold;
                            -fx-text-fill: #1E1B4B;"
                text="Nhập giá đấu của bạn" />

              <!-- Input giá -->
              <HBox alignment="CENTER_LEFT" spacing="0"
                style="-fx-background-color: linear-gradient(to right,#F5F3FF,#FDF2F8);
                           -fx-background-radius: 14;
                           -fx-padding: 8 18 8 18;
                           -fx-border-color: #A78BFA;
                           -fx-border-radius: 14; -fx-border-width: 1.5;
                           -fx-effect: dropshadow(gaussian,rgba(167,139,250,0.2),10,0,0,3);">
                <Label style="-fx-font-size: 22px; -fx-text-fill: #A78BFA;
                              -fx-font-weight: bold;" text="đ " />
                <TextField fx:id="txtBidAmount"
                  promptText="Nhập số tiền muốn đặt..."
                  style="-fx-background-color: transparent;
                                  -fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #4C1D95;
                                  -fx-border-width: 0;
                                  -fx-prompt-text-fill: #C4B5FD;"
                  HBox.hgrow="ALWAYS" />
              </HBox>

              <!-- Giá tối thiểu -->
              <Label fx:id="lblMinBid"
                style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;
                            -fx-padding: 0 4;" />

              <!-- Quick-bid buttons -->
              <HBox spacing="8">
                <Button fx:id="btnQuick1" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to right,#EDE9FE,#DDD6FE);
                               -fx-text-fill: #6D28D9;
                               -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-padding: 7 10;"
                  text="+1 bước" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnQuick2" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to right,#FCE7F3,#FBCFE8);
                               -fx-text-fill: #BE185D;
                               -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-padding: 7 10;"
                  text="+3 bước" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnQuick3" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to right,#EFF6FF,#DBEAFE);
                               -fx-text-fill: #1D4ED8;
                               -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-padding: 7 10;"
                  text="+5 bước" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnQuick4" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to right,#ECFDF5,#D1FAE5);
                               -fx-text-fill: #065F46;
                               -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-font-size: 11px; -fx-font-weight: bold;
                               -fx-padding: 7 10;"
                  text="+10 bước" HBox.hgrow="ALWAYS" />
              </HBox>

              <!-- Bid Slider -->
              <VBox spacing="4">
                <HBox alignment="CENTER_LEFT">
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;"
                    text="Kéo để chọn mức giá nhanh" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="lblSliderVal"
                    style="-fx-font-size: 11px; -fx-text-fill: #7C3AED;
                                -fx-font-weight: bold;" text="---" />
                </HBox>
                <Slider fx:id="bidSlider" min="0" max="100" value="0"
                  style="-fx-accent: linear-gradient(to right,#8B5CF6,#EC4899);"
                  maxWidth="Infinity" />
              </VBox>

              <!-- Error / Success -->
              <Label fx:id="lblBidError" maxWidth="Infinity"
                style="-fx-text-fill: #BE123C; -fx-font-size: 12px;
                            -fx-background-color: linear-gradient(to right,#FFF1F2,#FFE4E6);
                            -fx-background-radius: 10; -fx-padding: 8 14;
                            -fx-border-color: #FCA5A5; -fx-border-radius: 10;
                            -fx-border-width: 1;"
                visible="false" />
              <Label fx:id="lblBidStatus" maxWidth="Infinity"
                style="-fx-text-fill: #065F46; -fx-font-size: 12px;
                            -fx-background-color: linear-gradient(to right,#ECFDF5,#D1FAE5);
                            -fx-background-radius: 10; -fx-padding: 8 14;
                            -fx-border-color: #6EE7B7; -fx-border-radius: 10;
                            -fx-border-width: 1;"
                visible="false" />

              <!-- Nút đặt giá -->
              <Button fx:id="btnPlaceBid" maxWidth="Infinity"
                onAction="#handlePlaceBid"
                style="-fx-background-color: linear-gradient(to right,#8B5CF6,#EC4899,#F59E0B);
                             -fx-text-fill: white; -fx-font-size: 16px;
                             -fx-font-weight: bold; -fx-background-radius: 14;
                             -fx-padding: 15 0;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian,rgba(139,92,246,0.4),16,0,0,6);"
                text="🔨  ĐẶT GIÁ NGAY" />

              <!-- Confirm checkbox -->
              <HBox spacing="8" alignment="CENTER_LEFT">
                <CheckBox fx:id="chkConfirmBid"
                  style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"
                  text="Xác nhận trước khi đặt giá" />
              </HBox>

            </VBox>
          </Tab>

          <!-- ┌──────────────────────────────────┐ -->
          <!-- │  TAB 2: Auto-Bid                 │ -->
          <!-- └──────────────────────────────────┘ -->
          <Tab fx:id="tabAuto" text="🤖 Auto-Bid">
            <VBox spacing="16" style="-fx-background-color: white;
                                       -fx-padding: 20 24;
                                       -fx-background-radius: 0 0 18 18;">

              <!-- Header -->
              <VBox spacing="6"
                style="-fx-background-color: linear-gradient(to right,#EEF9FF,#E0F2FE);
                           -fx-background-radius: 12; -fx-padding: 14 18;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;
                              -fx-text-fill: #075985;"
                  text="🤖 Đấu giá tự động (Auto-Bid)" />
                <Label maxWidth="440"
                  style="-fx-font-size: 11px; -fx-text-fill: #0369A1;
                              -fx-wrap-text: true;"
                  text="Hệ thống tự động đặt giá thay bạn khi có bid mới. Chỉ trả giá khi cần thiết và không vượt mức tối đa của bạn." />
              </VBox>

              <!-- Trạng thái -->
              <Label fx:id="lblAutoBidInfo" maxWidth="Infinity"
                style="-fx-font-size: 12px; -fx-text-fill: #6B7280;
                            -fx-background-color: #F9FAFB; -fx-background-radius: 10;
                            -fx-padding: 10 14; -fx-border-color: #E5E7EB;
                            -fx-border-radius: 10; -fx-border-width: 1;"
                text="❌ Auto-Bid đang TẮT" />

              <Separator style="-fx-opacity: 0.4;" />

              <Label style="-fx-font-weight: bold; -fx-font-size: 13px;
                            -fx-text-fill: #374151;"
                text="⚙️ Cấu hình Auto-Bid" />

              <!-- Strategy selector -->
              <HBox spacing="10" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"
                  text="Chiến lược:" />
                <ComboBox fx:id="cmbStrategy"
                  style="-fx-background-radius: 8; -fx-font-size: 12px;"
                  prefWidth="200">
                  <items>
                    <FXCollections fx:factory="observableArrayList">
                      <String fx:value="🐢 Tăng từng bước (Conservative)" />
                      <String fx:value="⚡ Tăng nhanh (Aggressive)" />
                      <String fx:value="🎯 Đặt 1 lần tối đa (Sniper)" />
                    </FXCollections>
                  </items>
                </ComboBox>
              </HBox>

              <HBox spacing="12">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"
                    text="💎 Giá tối đa (maxBid)" />
                  <HBox style="-fx-background-color: linear-gradient(to right,#F5F3FF,#FDF4FF);
                               -fx-background-radius: 10;
                               -fx-padding: 7 12;
                               -fx-border-color: #DDD6FE;
                               -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label style="-fx-text-fill: #A78BFA; -fx-font-size: 14px;
                                  -fx-font-weight: bold;" text="đ " />
                    <TextField fx:id="txtMaxBid" promptText="VD: 5000000"
                      style="-fx-background-color: transparent;
                                      -fx-border-width: 0; -fx-font-size: 13px;
                                      -fx-text-fill: #4C1D95;"
                      HBox.hgrow="ALWAYS" />
                  </HBox>
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                  <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"
                    text="📈 Bước tăng (increment)" />
                  <HBox style="-fx-background-color: linear-gradient(to right,#FFF0F6,#FDF2F8);
                               -fx-background-radius: 10;
                               -fx-padding: 7 12;
                               -fx-border-color: #FBCFE8;
                               -fx-border-radius: 10; -fx-border-width: 1.5;">
                    <Label style="-fx-text-fill: #F472B6; -fx-font-size: 14px;
                                  -fx-font-weight: bold;" text="đ " />
                    <TextField fx:id="txtIncrement" promptText="VD: 50000"
                      style="-fx-background-color: transparent;
                                      -fx-border-width: 0; -fx-font-size: 13px;
                                      -fx-text-fill: #831843;"
                      HBox.hgrow="ALWAYS" />
                  </HBox>
                </VBox>
              </HBox>

              <!-- Delay setting -->
              <HBox spacing="10" alignment="CENTER_LEFT">
                <Label style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"
                  text="⏳ Độ trễ phản hồi:" />
                <Slider fx:id="autoDelaySlider" min="0" max="30" value="3"
                  prefWidth="140"
                  style="-fx-accent: #8B5CF6;" />
                <Label fx:id="lblAutoDelay"
                  style="-fx-font-size: 11px; -fx-text-fill: #7C3AED;
                              -fx-font-weight: bold;" text="3 giây" />
              </HBox>

              <!-- Status msg -->
              <Label fx:id="lblAutoBidStatus" maxWidth="Infinity"
                style="-fx-font-size: 12px; -fx-background-radius: 8;
                            -fx-padding: 8 12;"
                visible="false" />

              <!-- Buttons -->
              <HBox spacing="10">
                <Button fx:id="btnSetAutoBid" maxWidth="Infinity"
                  onAction="#handleSetAutoBid"
                  style="-fx-background-color: linear-gradient(to right,#059669,#10B981);
                               -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-font-size: 13px; -fx-background-radius: 12;
                               -fx-padding: 12 0; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian,rgba(16,185,129,0.35),12,0,0,4);"
                  text="✅ Kích hoạt Auto-Bid" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnCancelAutoBid" disable="true"
                  onAction="#handleCancelAutoBid"
                  style="-fx-background-color: linear-gradient(to right,#FFF1F2,#FFE4E6);
                               -fx-text-fill: #E11D48; -fx-background-radius: 12;
                               -fx-padding: 12 16; -fx-cursor: hand;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-border-color: #FCA5A5; -fx-border-radius: 12;
                               -fx-border-width: 1;"
                  text="❌ Huỷ" />
              </HBox>

            </VBox>
          </Tab>

          <!-- ┌──────────────────────────────────┐ -->
          <!-- │  TAB 3: Biểu đồ                  │ -->
          <!-- └──────────────────────────────────┘ -->
          <Tab fx:id="tabChart" text="📈 Biểu đồ">
            <VBox spacing="10" style="-fx-background-color: white;
                                       -fx-padding: 16 20;
                                       -fx-background-radius: 0 0 18 18;">

              <HBox alignment="CENTER_LEFT" spacing="12">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;
                              -fx-text-fill: #1E1B4B;"
                  text="📈 Đường giá theo thời gian thực" />
                <Region HBox.hgrow="ALWAYS" />
                <ToggleButton fx:id="toggleSmoothChart"
                  style="-fx-background-radius: 8; -fx-font-size: 10px;
                                     -fx-background-color: #EDE9FE; -fx-text-fill: #6D28D9;"
                  text="Smooth" />
                <ComboBox fx:id="cmbChartType"
                  style="-fx-background-radius: 8; -fx-font-size: 11px;"
                  prefWidth="120">
                  <items>
                    <FXCollections fx:factory="observableArrayList">
                      <String fx:value="Line Chart" />
                      <String fx:value="Bar Chart" />
                    </FXCollections>
                  </items>
                </ComboBox>
              </HBox>

              <!-- Stats mini-cards -->
              <HBox spacing="10">
                <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #FFF5F7; -fx-background-radius: 10;
                             -fx-padding: 10 0; -fx-border-color: #FED7E2;
                             -fx-border-radius: 10; -fx-border-width: 1;">
                  <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
                    text="Giá cao nhất" />
                  <Label fx:id="lblChartMax"
                    style="-fx-font-size: 13px; -fx-font-weight: bold;
                                -fx-text-fill: #DB2777;" text="---" />
                </VBox>
                <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #F0FFF4; -fx-background-radius: 10;
                             -fx-padding: 10 0; -fx-border-color: #C6F6D5;
                             -fx-border-radius: 10; -fx-border-width: 1;">
                  <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
                    text="Giá thấp nhất" />
                  <Label fx:id="lblChartMin"
                    style="-fx-font-size: 13px; -fx-font-weight: bold;
                                -fx-text-fill: #059669;" text="---" />
                </VBox>
                <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #EEF2FF; -fx-background-radius: 10;
                             -fx-padding: 10 0; -fx-border-color: #C7D2FE;
                             -fx-border-radius: 10; -fx-border-width: 1;">
                  <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
                    text="Trung bình" />
                  <Label fx:id="lblChartAvg"
                    style="-fx-font-size: 13px; -fx-font-weight: bold;
                                -fx-text-fill: #4338CA;" text="---" />
                </VBox>
                <VBox alignment="CENTER" spacing="2" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: #FFFBEB; -fx-background-radius: 10;
                             -fx-padding: 10 0; -fx-border-color: #FDE68A;
                             -fx-border-radius: 10; -fx-border-width: 1;">
                  <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
                    text="Biến động" />
                  <Label fx:id="lblChartVolatility"
                    style="-fx-font-size: 13px; -fx-font-weight: bold;
                                -fx-text-fill: #B45309;" text="---" />
                </VBox>
              </HBox>

              <LineChart fx:id="priceChart" prefHeight="260"
                style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <xAxis>
                  <NumberAxis autoRanging="true" label="Lượt cập nhật"
                    fx:id="xAxis" />
                </xAxis>
                <yAxis>
                  <NumberAxis fx:id="yAxis" autoRanging="true" label="Giá (đ)" />
                </yAxis>
              </LineChart>
            </VBox>
          </Tab>

          <!-- ┌──────────────────────────────────┐ -->
          <!-- │  TAB 4: Lịch sử                  │ -->
          <!-- └──────────────────────────────────┘ -->
          <Tab fx:id="tabHistory" text="📋 Lịch sử">
            <VBox spacing="10" style="-fx-background-color: white;
                                       -fx-padding: 16 18;
                                       -fx-background-radius: 0 0 18 18;">
              <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #1E1B4B;"
                  text="Lịch sử đặt giá" />
                <Label fx:id="lblHistoryCount"
                  style="-fx-background-color: linear-gradient(to right,#8B5CF6,#EC4899);
                              -fx-text-fill: white; -fx-background-radius: 20;
                              -fx-padding: 2 10; -fx-font-size: 10px;
                              -fx-font-weight: bold;" text="0" />
                <Region HBox.hgrow="ALWAYS" />
                <!-- Filter -->
                <ComboBox fx:id="cmbHistoryFilter"
                  style="-fx-background-radius: 8; -fx-font-size: 11px;"
                  prefWidth="140">
                  <items>
                    <FXCollections fx:factory="observableArrayList">
                      <String fx:value="Tất cả" />
                      <String fx:value="Của tôi" />
                      <String fx:value="Auto-Bid" />
                      <String fx:value="Top 5" />
                    </FXCollections>
                  </items>
                </ComboBox>
                <Button onAction="#handleRefreshBids"
                  style="-fx-background-color: linear-gradient(to right,#EDE9FE,#DDD6FE);
                               -fx-text-fill: #6D28D9; -fx-background-radius: 10;
                               -fx-cursor: hand; -fx-padding: 5 14;
                               -fx-font-size: 11px; -fx-font-weight: bold;"
                  text="↻ Làm mới" />
              </HBox>

              <!-- Search in history -->
              <HBox style="-fx-background-color: #F9FAFB; -fx-background-radius: 10;
                           -fx-padding: 6 12; -fx-border-color: #E5E7EB;
                           -fx-border-radius: 10; -fx-border-width: 1;">
                <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;" text="🔍 " />
                <TextField fx:id="txtHistorySearch"
                  promptText="Tìm theo tên người dùng..."
                  style="-fx-background-color: transparent;
                                  -fx-border-width: 0; -fx-font-size: 12px;"
                  HBox.hgrow="ALWAYS" />
              </HBox>

              <ScrollPane fx:id="scrollHistory" fitToWidth="true" prefHeight="330"
                style="-fx-background-color: transparent;
                                 -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
                <VBox fx:id="vboxBidHistory" spacing="8"
                  style="-fx-padding: 2 4 2 4;" />
              </ScrollPane>
            </VBox>
          </Tab>

          <!-- ┌──────────────────────────────────┐ -->
          <!-- │  TAB 5: Chat Room                │ -->
          <!-- └──────────────────────────────────┘ -->
          <Tab fx:id="tabChat" text="💬 Chat">
            <VBox spacing="10" style="-fx-background-color: white;
                                       -fx-padding: 16 18;
                                       -fx-background-radius: 0 0 18 18;"
              VBox.vgrow="ALWAYS">

              <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-font-size: 14px; -fx-font-weight: bold;
                              -fx-text-fill: #1E1B4B;"
                  text="💬 Thảo luận phòng đấu giá" />
                <Label fx:id="lblOnlineCount"
                  style="-fx-background-color: #ECFDF5; -fx-text-fill: #065F46;
                              -fx-background-radius: 20; -fx-padding: 2 10;
                              -fx-font-size: 10px; -fx-font-weight: bold;"
                  text="🟢 0 online" />
              </HBox>

              <ScrollPane fx:id="scrollChat" fitToWidth="true"
                style="-fx-background-color: #F9FAFB;
                                 -fx-background: #F9FAFB; -fx-background-radius: 12;"
                prefHeight="300" VBox.vgrow="ALWAYS">
                <VBox fx:id="vboxChat" spacing="8"
                  style="-fx-padding: 12;" />
              </ScrollPane>

              <!-- Emoji bar -->
              <HBox spacing="6">
                <Button onAction="#handleChatEmoji" style="-fx-background-color: transparent;
                                                           -fx-cursor: hand; -fx-font-size: 16px;"
                  text="👍" />
                <Button onAction="#handleChatEmoji" style="-fx-background-color: transparent;
                                                           -fx-cursor: hand; -fx-font-size: 16px;"
                  text="🔥" />
                <Button onAction="#handleChatEmoji" style="-fx-background-color: transparent;
                                                           -fx-cursor: hand; -fx-font-size: 16px;"
                  text="💎" />
                <Button onAction="#handleChatEmoji" style="-fx-background-color: transparent;
                                                           -fx-cursor: hand; -fx-font-size: 16px;"
                  text="🏆" />
                <Button onAction="#handleChatEmoji" style="-fx-background-color: transparent;
                                                           -fx-cursor: hand; -fx-font-size: 16px;"
                  text="😮" />
              </HBox>

              <!-- Chat input -->
              <HBox spacing="8" alignment="CENTER_LEFT">
                <HBox HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                             -fx-padding: 7 14; -fx-border-color: #E5E7EB;
                             -fx-border-radius: 12; -fx-border-width: 1.5;">
                  <TextField fx:id="txtChatMessage"
                    promptText="Nhập tin nhắn..."
                    style="-fx-background-color: transparent;
                                    -fx-border-width: 0; -fx-font-size: 13px;"
                    HBox.hgrow="ALWAYS" />
                </HBox>
                <Button
                  text="Gửi ➤"
                  onAction="#handleSendChat"
                  style="-fx-background-color: linear-gradient(to right, #8B5CF6, #EC4899); -fx-text-fill: white; -fx-background-radius: 12; -fx-padding: 9 18; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px;" />
              </HBox>

            </VBox>
          </Tab>

        </TabPane>
      </VBox>

      <!-- ════════ RIGHT: Live Panel ════════ -->
      <VBox prefWidth="230" spacing="12">

        <!-- Live activity feed -->
        <VBox spacing="10"
          style="-fx-background-color: white; -fx-background-radius: 16;
                     -fx-padding: 16;
                     -fx-effect: dropshadow(gaussian,rgba(99,102,241,0.08),16,0,0,5);">

          <HBox alignment="CENTER_LEFT" spacing="6">
            <Circle fx:id="liveCircle" fill="#EF4444" radius="5" />
            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;
                          -fx-text-fill: #1F2937;"
              text="LIVE" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblUpdateTick"
              style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
              text="● ---" />
          </HBox>

          <Separator style="-fx-opacity: 0.3;" />

          <ScrollPane fitToWidth="true" prefHeight="160"
            style="-fx-background-color: transparent;
                             -fx-background: transparent;">
            <VBox fx:id="vboxLiveFeed" spacing="6"
              style="-fx-padding: 0 2;" />
          </ScrollPane>
        </VBox>

        <!-- Leaderboard mini -->
        <VBox spacing="10"
          style="-fx-background-color: white; -fx-background-radius: 16;
                     -fx-padding: 16;
                     -fx-effect: dropshadow(gaussian,rgba(99,102,241,0.08),16,0,0,5);">

          <Label style="-fx-font-size: 12px; -fx-font-weight: bold;
                        -fx-text-fill: #1F2937;"
            text="🏆 Bảng xếp hạng" />

          <Separator style="-fx-opacity: 0.3;" />

          <VBox fx:id="vboxLeaderboard" spacing="6">
            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"
              text="Chưa có dữ liệu..." />
          </VBox>
        </VBox>

        <!-- Notification settings -->
        <VBox spacing="10"
          style="-fx-background-color: white; -fx-background-radius: 16;
                     -fx-padding: 16;
                     -fx-effect: dropshadow(gaussian,rgba(99,102,241,0.08),16,0,0,5);">

          <Label style="-fx-font-size: 12px; -fx-font-weight: bold;
                        -fx-text-fill: #1F2937;"
            text="🔔 Cài đặt thông báo" />

          <Separator style="-fx-opacity: 0.3;" />

          <CheckBox fx:id="chkNotifyOutbid"
            style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"
            text="Bị vượt giá" selected="true" />
          <CheckBox fx:id="chkNotifyNewBid"
            style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"
            text="Có bid mới" selected="true" />
          <CheckBox fx:id="chkNotify5Min"
            style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"
            text="Còn 5 phút" selected="true" />
          <CheckBox fx:id="chkNotifySound"
            style="-fx-font-size: 11px; -fx-text-fill: #4B5563;"
            text="Âm thanh" selected="true" />
        </VBox>

        <!-- Similar auctions -->
        <VBox spacing="8"
          style="-fx-background-color: white; -fx-background-radius: 16;
                     -fx-padding: 16;
                     -fx-effect: dropshadow(gaussian,rgba(99,102,241,0.08),16,0,0,5);"
          VBox.vgrow="ALWAYS">
          <Label style="-fx-font-size: 12px; -fx-font-weight: bold;
                        -fx-text-fill: #1F2937;"
            text="🔗 Phiên tương tự" />
          <Separator style="-fx-opacity: 0.3;" />
          <VBox fx:id="vboxSimilar" spacing="6">
            <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;"
              text="Đang tải..." />
          </VBox>
        </VBox>

      </VBox>

    </HBox>
  </center>

  <!-- ══════════════════════════ BOTTOM ══════════════════════════════ -->
  <bottom>
    <HBox alignment="CENTER_LEFT" spacing="16"
      style="-fx-background-color: white;
                 -fx-padding: 8 24 8 24;
                 -fx-border-color: #F3F4F6; -fx-border-width: 1 0 0 0;">
      <Label style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
        text="🛡️ Bảo mật SSL · Phiên đấu giá được giám sát" />
      <Region HBox.hgrow="ALWAYS" />
      <Label fx:id="lblLastUpdate"
        style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;"
        text="Cập nhật: ---" />
      <Label style="-fx-font-size: 10px; -fx-text-fill: #C4B5FD;"
        text="● Kết nối ổn định" />
    </HBox>
  </bottom>

</BorderPane>
