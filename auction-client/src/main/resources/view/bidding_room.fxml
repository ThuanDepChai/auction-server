<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
  fx:controller="com.nhom15.client.controller.BiddingRoomController"
  prefWidth="1200" prefHeight="760"
  style="-fx-background-color: #F0F4F8;">

  <!-- ══════════════════════════════ TOP BAR ══════════════════════════════ -->
  <top>
    <VBox>
      <HBox alignment="CENTER_LEFT" spacing="12"
        style="-fx-background-color: white;
               -fx-padding: 12 24 12 24;
               -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.1),8,0,0,2);">
        <Button text="← Quay lại"
          onAction="#handleBack"
          style="-fx-background-color: #F0F0F0; -fx-background-radius: 8;
                 -fx-padding: 6 14 6 14; -fx-cursor: hand; -fx-font-size: 12px;"/>
        <Label fx:id="lblTitle" text="🏛️ Phòng đấu giá"
          style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <!-- Anti-snipe alert -->
        <Label fx:id="lblAntiSnipe" visible="false"
          style="-fx-background-color: #FFF3CD; -fx-text-fill: #856404;
                 -fx-background-radius: 8; -fx-padding: 5 12 5 12;
                 -fx-font-size: 11px; -fx-font-weight: bold;"/>
        <Label fx:id="lblStatus" text="ACTIVE"
          style="-fx-background-color: #E8F5E9; -fx-text-fill: #27AE60;
                 -fx-background-radius: 10; -fx-padding: 4 14 4 14;
                 -fx-font-weight: bold; -fx-font-size: 11px;"/>
      </HBox>
    </VBox>
  </top>

  <!-- ══════════════════════════════ CENTER ══════════════════════════════ -->
  <center>
    <HBox spacing="16" style="-fx-padding: 16;">

      <!-- ════════════ LEFT COLUMN: sản phẩm ════════════ -->
      <VBox spacing="12" prefWidth="360"
        style="-fx-background-color: white; -fx-background-radius: 14;
               -fx-padding: 18; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,4);">

        <!-- Ảnh sản phẩm -->
        <StackPane prefHeight="240"
          style="-fx-background-color: #F4F7FC; -fx-background-radius: 10;">
          <ImageView fx:id="imgProduct" fitWidth="320" fitHeight="240" preserveRatio="true"/>
          <Label fx:id="lblImgPlaceholder" text="🖼"
            style="-fx-font-size: 48px; -fx-text-fill: #CCCCCC;"/>
        </StackPane>

        <!-- Tên sản phẩm -->
        <Label fx:id="lblProductName"
          style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #222;
                 -fx-wrap-text: true;"/>

        <!-- Danh mục -->
        <Label fx:id="lblCategory"
          style="-fx-font-size: 11px; -fx-text-fill: #888; -fx-background-color: #F0F4F8;
                 -fx-background-radius: 6; -fx-padding: 3 8 3 8;"/>

        <!-- Mô tả -->
        <Label fx:id="lblDescription"
          style="-fx-font-size: 12px; -fx-text-fill: #666; -fx-wrap-text: true;"
          maxWidth="320"/>

        <Separator/>

        <!-- Seller + giá khởi điểm -->
        <HBox spacing="8" alignment="CENTER_LEFT">
          <Label fx:id="lblSeller" style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
        </HBox>
        <Label fx:id="lblStartPrice"
          style="-fx-font-size: 11px; -fx-text-fill: #999;"/>

      </VBox>

      <!-- ════════════ RIGHT COLUMN ════════════ -->
      <VBox spacing="12" HBox.hgrow="ALWAYS">

        <!-- ── Stats bar: Giá + Đồng hồ + Leader ── -->
        <HBox spacing="12">

          <!-- Giá hiện tại -->
          <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
            style="-fx-background-color: white; -fx-background-radius: 12;
                   -fx-padding: 14 10 14 10;
                   -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,3);
                   -fx-border-color: #FFE0E3; -fx-border-radius: 12; -fx-border-width: 1.5;">
            <Label text="💰 Giá hiện tại"
              style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
            <Label fx:id="lblCurrentPrice" text="---"
              style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #D96570;"/>
            <Label fx:id="lblLeader" text="Chưa có ai dẫn đầu"
              style="-fx-text-fill: #AAAAAA; -fx-font-size: 11px;"/>
          </VBox>

          <!-- Đồng hồ đếm ngược -->
          <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
            style="-fx-background-color: white; -fx-background-radius: 12;
                   -fx-padding: 14 10 14 10;
                   -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),8,0,0,3);
                   -fx-border-color: #D6E4FF; -fx-border-radius: 12; -fx-border-width: 1.5;">
            <Label text="⏱ Thời gian còn lại"
              style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
            <Label fx:id="lblCountdown" text="--:--:--"
              style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #4285F4;"/>
            <Label fx:id="lblTotalBids" text="0 lượt đặt"
              style="-fx-text-fill: #AAAAAA; -fx-font-size: 11px;"/>
          </VBox>

        </HBox>

        <!-- ── TabPane chính ── -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 12;">

          <!-- ┌─────────────────────────────────────────┐ -->
          <!-- │  TAB 1: Đặt giá thủ công                │ -->
          <!-- └─────────────────────────────────────────┘ -->
          <Tab fx:id="tabManual" text="🔨 Đặt giá">
            <VBox spacing="12"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 0 0 12 12;">

              <Label text="Đặt giá của bạn"
                style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>

              <!-- Input giá -->
              <HBox spacing="0" alignment="CENTER_LEFT"
                style="-fx-background-color: #F4F7FC; -fx-background-radius: 10;
                       -fx-padding: 6 14 6 14; -fx-border-color: #DDE4EF;
                       -fx-border-radius: 10; -fx-border-width: 1;">
                <Label text="đ "
                  style="-fx-font-size: 18px; -fx-text-fill: #888; -fx-font-weight: bold;"/>
                <TextField fx:id="txtBidAmount" promptText="Nhập số tiền muốn đặt"
                  style="-fx-background-color: transparent; -fx-font-size: 17px;
                         -fx-font-weight: bold; -fx-border-width: 0;"
                  HBox.hgrow="ALWAYS"/>
              </HBox>

              <!-- Giá tối thiểu -->
              <Label fx:id="lblMinBid"
                style="-fx-font-size: 11px; -fx-text-fill: #888;"/>

              <!-- Quick-bid buttons -->
              <HBox spacing="8">
                <Button fx:id="btnQuick1" text="+1 bước"
                  style="-fx-background-color: #EEF2FF; -fx-text-fill: #4285F4;
                         -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 11px;
                         -fx-padding: 5 10;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnQuick2" text="+3 bước"
                  style="-fx-background-color: #EEF2FF; -fx-text-fill: #4285F4;
                         -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 11px;
                         -fx-padding: 5 10;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="btnQuick3" text="+5 bước"
                  style="-fx-background-color: #EEF2FF; -fx-text-fill: #4285F4;
                         -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 11px;
                         -fx-padding: 5 10;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
              </HBox>

              <!-- Error / Success -->
              <Label fx:id="lblBidError" visible="false"
                style="-fx-text-fill: #D96570; -fx-font-size: 12px;
                       -fx-background-color: #FFEBEE; -fx-background-radius: 6;
                       -fx-padding: 6 10;" maxWidth="Infinity"/>
              <Label fx:id="lblBidStatus" visible="false"
                style="-fx-text-fill: #27AE60; -fx-font-size: 12px;
                       -fx-background-color: #E8F5E9; -fx-background-radius: 6;
                       -fx-padding: 6 10;" maxWidth="Infinity"/>

              <!-- Nút đặt giá -->
              <Button fx:id="btnPlaceBid" text="🔨 ĐẶT GIÁ NGAY"
                onAction="#handlePlaceBid" maxWidth="Infinity"
                style="-fx-background-color: linear-gradient(to right,#4285F4,#9B72CB);
                       -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-padding: 13 0; -fx-cursor: hand;"/>

            </VBox>
          </Tab>

          <!-- ┌─────────────────────────────────────────┐ -->
          <!-- │  TAB 2: Auto-Bid                        │ -->
          <!-- └─────────────────────────────────────────┘ -->
          <Tab fx:id="tabAuto" text="🤖 Auto-Bid">
            <VBox spacing="14"
              style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 0 0 12 12;">

              <!-- Header giải thích -->
              <VBox spacing="4"
                style="-fx-background-color: #EEF9FF; -fx-background-radius: 8;
                       -fx-padding: 10 14;">
                <Label text="🤖 Đấu giá tự động (Auto-Bid)"
                  style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1565C0;"/>
                <Label text="Hệ thống tự động đặt giá thay bạn khi có bid mới từ đối thủ, tăng từng bước cho đến khi chạm mức tối đa của bạn."
                  style="-fx-font-size: 11px; -fx-text-fill: #555; -fx-wrap-text: true;"
                  maxWidth="440"/>
              </VBox>

              <!-- Trạng thái Auto-Bid hiện tại -->
              <Label fx:id="lblAutoBidInfo" text="❌ Auto-Bid đang TẮT"
                style="-fx-font-size: 12px; -fx-text-fill: #888;
                       -fx-background-color: #F5F5F5; -fx-background-radius: 8;
                       -fx-padding: 8 12;" maxWidth="Infinity"/>

              <Separator/>

              <!-- Form cài đặt -->
              <Label text="Cấu hình Auto-Bid mới"
                style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #333;"/>

              <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                  <Label text="💎 Giá tối đa (maxBid)"
                    style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                  <HBox style="-fx-background-color: #F4F7FC; -fx-background-radius: 8;
                               -fx-padding: 5 10; -fx-border-color: #DDE4EF;
                               -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="đ "
                      style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtMaxBid" promptText="VD: 5000000"
                      style="-fx-background-color: transparent; -fx-border-width: 0;
                             -fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                  </HBox>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                  <Label text="📈 Bước tăng (increment)"
                    style="-fx-font-size: 11px; -fx-text-fill: #666;"/>
                  <HBox style="-fx-background-color: #F4F7FC; -fx-background-radius: 8;
                               -fx-padding: 5 10; -fx-border-color: #DDE4EF;
                               -fx-border-radius: 8; -fx-border-width: 1;">
                    <Label text="đ "
                      style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
                    <TextField fx:id="txtIncrement" promptText="VD: 50000"
                      style="-fx-background-color: transparent; -fx-border-width: 0;
                             -fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                  </HBox>
                </VBox>
              </HBox>

              <!-- Status message -->
              <Label fx:id="lblAutoBidStatus" visible="false"
                style="-fx-font-size: 12px; -fx-background-radius: 6;
                       -fx-padding: 6 10;" maxWidth="Infinity"/>

              <!-- Buttons -->
              <HBox spacing="10">
                <Button fx:id="btnSetAutoBid" text="✅ Kích hoạt Auto-Bid"
                  onAction="#handleSetAutoBid" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                  style="-fx-background-color: linear-gradient(to right,#27AE60,#2ECC71);
                         -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;
                         -fx-background-radius: 9; -fx-padding: 10 0; -fx-cursor: hand;"/>
                <Button fx:id="btnCancelAutoBid" text="❌ Huỷ Auto-Bid"
                  onAction="#handleCancelAutoBid" disable="true"
                  style="-fx-background-color: #FFEBEE; -fx-text-fill: #E53935;
                         -fx-background-radius: 9; -fx-padding: 10 16; -fx-cursor: hand;
                         -fx-font-size: 12px;"/>
              </HBox>

            </VBox>
          </Tab>

          <!-- ┌─────────────────────────────────────────┐ -->
          <!-- │  TAB 3: Biểu đồ giá                     │ -->
          <!-- └─────────────────────────────────────────┘ -->
          <Tab fx:id="tabChart" text="📈 Biểu đồ">
            <VBox spacing="8"
              style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 0 0 12 12;">
              <Label text="📈 Đường giá đấu theo thời gian thực"
                style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #333;"/>
              <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;"
                prefHeight="300">
                <xAxis>
                  <NumberAxis fx:id="xAxis" label="Lượt cập nhật" autoRanging="true"/>
                </xAxis>
                <yAxis>
                  <NumberAxis fx:id="yAxis" label="Giá (đ)" autoRanging="true"/>
                </yAxis>
              </LineChart>
            </VBox>
          </Tab>

          <!-- ┌─────────────────────────────────────────┐ -->
          <!-- │  TAB 4: Lịch sử bid                     │ -->
          <!-- └─────────────────────────────────────────┘ -->
          <Tab fx:id="tabHistory" text="📋 Lịch sử">
            <VBox spacing="8"
              style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 0 0 12 12;">
              <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Lịch sử đặt giá"
                  style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="↻ Làm mới" onAction="#handleRefreshBids"
                  style="-fx-background-color: #EEF2FF; -fx-text-fill: #4285F4;
                         -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 4 12;
                         -fx-font-size: 11px;"/>
              </HBox>
              <ScrollPane fx:id="scrollHistory" fitToWidth="true" prefHeight="340"
                style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
                <VBox fx:id="vboxBidHistory" spacing="6" style="-fx-padding: 2 4 2 4;"/>
              </ScrollPane>
            </VBox>
          </Tab>

        </TabPane>
      </VBox>
    </HBox>
  </center>

</BorderPane>
