                                    <Font size="13.0"/>
                                  </font>
                                </Label>
                                <Label text="Định dạng 24 giờ. VD: 20:00, 14:30" style="-fx-text-fill: #777777;">
                                  <font>
                                    <Font size="11.0"/>
                                  </font>
                                </Label>
                                <TextField fx:id="txtAuctionEndTime" prefHeight="45.0"
                                  promptText="VD: 20:00"
                                  style="-fx-background-color: #F4F7FC; -fx-background-radius: 8; -fx-padding: 0 15 0 15; -fx-text-fill: #222222;">
                                  <font>
                                    <Font size="13.0"/>
                                  </font>
                                </TextField>
                                <Label fx:id="lblAuctionTimeError" managed="false" visible="false"
                                  style="-fx-text-fill: #D96570;">
                                  <font>
                                    <Font name="System Italic" size="11.0"/>
                                  </font>
                                </Label>
                              </children>
                            </VBox>
                          </children>
                        </HBox>

                        <Separator/>

                        <!-- Action buttons -->
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                          <children>
                            <Label fx:id="lblCreateAuctionStatus" style="-fx-text-fill: #4CAF50;">
                              <font>
                                <Font name="System Italic" size="12.0"/>
                              </font>
                            </Label>
                            <Button mnemonicParsing="false" onAction="#handleCreateAuction"
                              prefHeight="48.0" prefWidth="200.0"
                              style="-fx-background-color: linear-gradient(to right, #4285F4, #9B72CB, #D96570); -fx-background-radius: 24; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                              text="⚡  Tạo phiên đấu giá">
                              <font>
                                <Font size="14.0"/>
                              </font>
                            </Button>
                          </children>
                        </HBox>

                      </children>
                    </VBox>
                  </children>
                </VBox>

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- PANEL: ĐƠN HÀNG (ORDERS) -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <VBox fx:id="panelOrders" spacing="20.0" visible="false" managed="false">
                  <padding>
                    <Insets bottom="40.0" left="35.0" right="35.0" top="30.0"/>
                  </padding>
                  <children>
                    <Label text="Quản lý đơn hàng"
                      style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                      <font>
                        <Font size="18.0"/>
                      </font>
                    </Label>
                    
                    <!-- Order status tabs -->
                    <HBox spacing="10.0">
                      <children>
                        <Button text="Chờ thanh toán" 
                          style="-fx-background-color: #FFA726; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 10 20 10 20; -fx-cursor: hand; -fx-font-weight: bold;">
                          <font><Font size="12.0"/></font>
                        </Button>
                        <Button text="Chờ lấy hàng"
                          style="-fx-background-color: #F4F7FC; -fx-text-fill: #666666; -fx-background-radius: 20; -fx-padding: 10 20 10 20; -fx-cursor: hand;">
                          <font><Font size="12.0"/></font>
                        </Button>
                        <Button text="Đang giao"
                          style="-fx-background-color: #F4F7FC; -fx-text-fill: #666666; -fx-background-radius: 20; -fx-padding: 10 20 10 20; -fx-cursor: hand;">
                          <font><Font size="12.0"/></font>
                        </Button>
                        <Button text="Hoàn thành"
                          style="-fx-background-color: #F4F7FC; -fx-text-fill: #666666; -fx-background-radius: 20; -fx-padding: 10 20 10 20; -fx-cursor: hand;">
                          <font><Font size="12.0"/></font>
                        </Button>
                        <Button text="Trả hàng/Hoàn tiền"
                          style="-fx-background-color: #F4F7FC; -fx-text-fill: #666666; -fx-background-radius: 20; -fx-padding: 10 20 10 20; -fx-cursor: hand;">
                          <font><Font size="12.0"/></font>
                        </Button>
                      </children>
                    </HBox>
                    
                    <VBox fx:id="vboxOrders" spacing="15.0"/>
                  </children>
                </VBox>

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- PANEL: TÀI CHÍNH (FINANCE) -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <VBox fx:id="panelFinance" spacing="20.0" visible="false" managed="false">
                  <padding>
                    <Insets bottom="40.0" left="35.0" right="35.0" top="30.0"/>
                  </padding>
                  <children>
                    <Label text="Quản lý tài chính"
                      style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                      <font>
                        <Font size="18.0"/>
                      </font>
                    </Label>
                    
                    <!-- Wallet balance -->
                    <HBox spacing="20.0">
                      <children>
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: linear-gradient(to right, #4285F4, #9B72CB); -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);">
                          <padding>
                            <Insets bottom="25.0" left="30.0" right="30.0" top="25.0"/>
                          </padding>
                          <children>
                            <Label text="Số dư ví" style="-fx-text-fill: rgba(255,255,255,0.9);">
                              <font><Font size="14.0"/></font>
                            </Label>
                            <Label fx:id="lblWalletBalance" text="0 đ" style="-fx-text-fill: white; -fx-font-weight: bold;">
                              <font><Font size="36.0"/></font>
                            </Label>
                            <Button text="Rút tiền" 
                              style="-fx-background-color: white; -fx-text-fill: #4285F4; -fx-background-radius: 20; -fx-padding: 10 25 10 25; -fx-cursor: hand; -fx-font-weight: bold;">
                              <font><Font size="12.0"/></font>
                            </Button>
                          </children>
                        </VBox>
                      </children>
                    </HBox>
                    
                    <!-- Transaction history -->
                    <VBox spacing="15.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                      <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                      </padding>
                      <children>
                        <Label text="Lịch sử giao dịch" style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                          <font><Font size="16.0"/></font>
                        </Label>
                        <Separator/>
                        <VBox fx:id="vboxTransactions" spacing="12.0"/>
                      </children>
                    </VBox>
                  </children>
                </VBox>

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- PANEL: PHÂN TÍCH (ANALYTICS) -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <VBox fx:id="panelAnalytics" spacing="20.0" visible="false" managed="false">
                  <padding>
                    <Insets bottom="40.0" left="35.0" right="35.0" top="30.0"/>
                  </padding>
                  <children>
                    <Label text="Phân tích và Thống kê"
                      style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                      <font>
                        <Font size="18.0"/>
                      </font>
                    </Label>
                    
                    <VBox spacing="15.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                      <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                      </padding>
                      <children>
                        <Label text="📊 Thống kê hiệu suất" style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                          <font><Font size="16.0"/></font>
                        </Label>
                        <Label text="Tính năng đang phát triển..." style="-fx-text-fill: #666666;">
                          <font><Font size="13.0"/></font>
                        </Label>
                      </children>
                    </VBox>
                  </children>
                </VBox>

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- PANEL: CÀI ĐẶT (SETTINGS) -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <VBox fx:id="panelSettings" spacing="20.0" visible="false" managed="false">
                  <padding>
                    <Insets bottom="40.0" left="35.0" right="35.0" top="30.0"/>
                  </padding>
                  <children>
                    <Label text="Cài đặt cửa hàng"
                      style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                      <font>
                        <Font size="18.0"/>
                      </font>
                    </Label>
                    
                    <VBox spacing="15.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                      <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                      </padding>
                      <children>
                        <Label text="⚙️ Cài đặt chung" style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                          <font><Font size="16.0"/></font>
                        </Label>
                        <Label text="Tính năng đang phát triển..." style="-fx-text-fill: #666666;">
                          <font><Font size="13.0"/></font>
                        </Label>
                      </children>
                    </VBox>
                  </children>
                </VBox>

              </children>
            </StackPane>
          </content>
        </ScrollPane>
      </children>
    </VBox>
  </center>

</BorderPane>
