<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.CategoryAxis?>

<BorderPane prefHeight="900.0" prefWidth="1400.0"
  style="-fx-background-color: #F4F7FC;"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.nhom15.client.controller.SellerDashboardController">

  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <!-- SIDEBAR -->
  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <left>
    <VBox prefWidth="250.0" spacing="5.0"
      style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
      <padding>
        <Insets bottom="20.0" left="0.0" right="0.0" top="0.0"/>
      </padding>
      <children>

        <!-- Logo & User Info -->
        <VBox alignment="CENTER" prefHeight="100.0"
          style="-fx-background-color: linear-gradient(to right, #4285F4, #9B72CB, #D96570);">
          <children>
            <Label text="✧ Gemini Seller"
              style="-fx-text-fill: white; -fx-font-weight: bold;">
              <font>
                <Font size="22.0"/>
              </font>
            </Label>
            <Label fx:id="lblSellerName" text="Nhà bán hàng"
              style="-fx-text-fill: rgba(255,255,255,0.9);">
              <font>
                <Font size="13.0"/>
              </font>
            </Label>
          </children>
        </VBox>

        <!-- Menu Navigation -->
        <VBox spacing="3.0">
          <padding>
            <Insets top="20.0"/>
          </padding>
          <children>

            <Button fx:id="btnMenuOverview" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuOverview"
              style="-fx-background-color: linear-gradient(to right, #4285F4, #9B72CB); -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand; -fx-font-weight: bold;"
              text="📊  Tổng quan">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuItems" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuItems"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="📦  Sản phẩm của tôi">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuAddItem" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuAddItem"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="➕  Đăng sản phẩm">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuAuctions" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuAuctions"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="🔨  Phiên đấu giá">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuCreateAuction" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuCreateAuction"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="⚡  Tạo phiên đấu giá">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuOrders" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuOrders"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="📋  Đơn hàng">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuFinance" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuFinance"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="💰  Tài chính">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuAnalytics" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuAnalytics"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="📈  Phân tích">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

            <Button fx:id="btnMenuSettings" maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleMenuSettings"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="⚙️  Cài đặt">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>

          </children>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Bottom Buttons -->
        <VBox spacing="3.0">
          <children>
            <Separator/>
            <Button maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleGoHome"
              style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="🏠  Về trang chủ">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>
            <Button maxWidth="Infinity" mnemonicParsing="false"
              onAction="#handleLogout"
              style="-fx-background-color: transparent; -fx-text-fill: #D96570; -fx-alignment: CENTER_LEFT; -fx-padding: 14 20 14 20; -fx-cursor: hand;"
              text="🚪  Đăng xuất">
              <font>
                <Font size="13.0"/>
              </font>
            </Button>
          </children>
        </VBox>

      </children>
    </VBox>
  </left>

  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <!-- MAIN CONTENT -->
  <!-- ══════════════════════════════════════════════════════════════════════ -->
  <center>
    <VBox spacing="0.0">
      <children>

        <!-- Header Bar -->
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0"
          style="-fx-background-color: white; -fx-border-color: #EEEEEE; -fx-border-width: 0 0 1 0;">
          <padding>
            <Insets left="30.0" right="30.0"/>
          </padding>
          <children>
            <Label fx:id="lblPageTitle" text="Tổng quan"
              style="-fx-font-weight: bold; -fx-text-fill: #222222;">
              <font>
                <Font size="22.0"/>
              </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblDateTime" style="-fx-text-fill: #666666;">
              <font>
                <Font size="13.0"/>
              </font>
            </Label>
          </children>
        </HBox>

        <!-- Main Content Scrollable Area -->
        <ScrollPane fx:id="mainScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
          style="-fx-background-color: transparent; -fx-background: transparent;">
          <content>

            <!-- StackPane for all content panels -->
            <StackPane fx:id="contentStack">
              <children>

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- PANEL: TỔNG QUAN (OVERVIEW) -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <VBox fx:id="panelOverview" spacing="25.0">
                  <padding>
                    <Insets bottom="40.0" left="35.0" right="35.0" top="30.0"/>
                  </padding>
                  <children>

                    <!-- Quick Stats Cards -->
                    <GridPane hgap="20.0" vgap="20.0">
                      <children>
                        <!-- Card 1: Tổng sản phẩm -->
                        <VBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          prefHeight="120.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                          <padding>
                            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
                          </padding>
                          <children>
                            <Label text="📦 Tổng sản phẩm" style="-fx-text-fill: #666666;">
                              <font>
                                <Font size="13.0"/>
                              </font>
                            </Label>
                            <Label fx:id="lblTotalItems" text="0"
                              style="-fx-font-weight: bold; -fx-text-fill: #4285F4;">
                              <font>
                                <Font size="36.0"/>
                              </font>
                            </Label>
                            <Label text="Sản phẩm đang bán" style="-fx-text-fill: #999999;">
                              <font>
                                <Font size="11.0"/>
                              </font>
                            </Label>
                          </children>
                        </VBox>

                        <!-- Card 2: Đang đấu giá -->
                        <VBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          prefHeight="120.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                          <padding>
                            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
                          </padding>
                          <children>
                            <Label text="🔨 Đang đấu giá" style="-fx-text-fill: #666666;">
                              <font>
                                <Font size="13.0"/>
                              </font>
                            </Label>
                            <Label fx:id="lblActiveAuctions" text="0"
                              style="-fx-font-weight: bold; -fx-text-fill: #9B72CB;">
                              <font>
                                <Font size="36.0"/>
                              </font>
                            </Label>
                            <Label text="Phiên đang hoạt động" style="-fx-text-fill: #999999;">
                              <font>
                                <Font size="11.0"/>
                              </font>
                            </Label>
                          </children>
                        </VBox>

                        <!-- Card 3: Đã bán -->
                        <VBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="2" GridPane.rowIndex="0"
                          prefHeight="120.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                          <padding>
                            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
                          </padding>
                          <children>
                            <Label text="✅ Đã bán" style="-fx-text-fill: #666666;">
                              <font>
                                <Font size="13.0"/>
                              </font>
                            </Label>
                            <Label fx:id="lblTotalSold" text="0"
                              style="-fx-font-weight: bold; -fx-text-fill: #D96570;">
                              <font>
                                <Font size="36.0"/>
                              </font>
                            </Label>
                            <Label text="Sản phẩm đã bán thành công" style="-fx-text-fill: #999999;">
                              <font>
                                <Font size="11.0"/>
                              </font>
                            </Label>
                          </children>
                        </VBox>

                        <!-- Card 4: Doanh thu -->
                        <VBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="3" GridPane.rowIndex="0"
                          prefHeight="120.0"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                          <padding>
                            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0"/>
                          </padding>
                          <children>
                            <Label text="💰 Doanh thu" style="-fx-text-fill: #666666;">
                              <font>
                                <Font size="13.0"/>
                              </font>
                            </Label>
                            <Label fx:id="lblTotalRevenue" text="0đ"
                              style="-fx-font-weight: bold; -fx-text-fill: #27AE60;">
                              <font>
                                <Font size="28.0"/>
                              </font>
                            </Label>
                            <Label text="Tổng thu nhập" style="-fx-text-fill: #999999;">
                              <font>
                                <Font size="11.0"/>
                              </font>
                            </Label>
                          </children>
                        </VBox>
                      </children>
                    </GridPane>

                    <!-- Notifications / Alerts -->
                    <VBox spacing="15.0"
                      style="-fx-background-color: #FFF8E1; -fx-background-radius: 12; -fx-border-color: #FFB74D; -fx-border-width: 1; -fx-border-radius: 12;">
                      <padding>
                        <Insets bottom="18.0" left="22.0" right="22.0" top="18.0"/>
                      </padding>
                      <children>
                        <HBox spacing="12.0" alignment="CENTER_LEFT">
                          <children>
                            <Label text="⚠️" style="-fx-font-size: 22px;"/>
                            <VBox spacing="4.0">
                              <children>
                                <Label text="Thông báo quan trọng" 
                                  style="-fx-font-weight: bold; -fx-text-fill: #E65100;">
                                  <font>
                                    <Font size="14.0"/>
                                  </font>
                                </Label>
                                <Label fx:id="lblNotifications" text="Bạn có 3 phiên đấu giá sắp kết thúc trong 24 giờ tới"
                                  style="-fx-text-fill: #424242;" wrapText="true">
                                  <font>
                                    <Font size="12.0"/>
                                  </font>
                                </Label>
                              </children>
                            </VBox>
                          </children>
                        </HBox>
                      </children>
                    </VBox>

                    <!-- Revenue Chart -->
                    <VBox spacing="18.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                      <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                      </padding>
                      <children>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                          <children>
                            <Label text="📊 Doanh thu theo thời gian"
                              style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                              <font>
                                <Font size="16.0"/>
                              </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="cmbRevenueTimeframe" promptText="7 ngày" prefWidth="120.0"
                              style="-fx-background-color: #F4F7FC; -fx-background-radius: 8;"/>
                          </children>
                        </HBox>
                        <Separator/>
                        <LineChart fx:id="chartRevenue" prefHeight="300.0" legendVisible="false">
                          <xAxis>
                            <CategoryAxis label="Thời gian" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis label="Doanh thu (đ)" />
                          </yAxis>
                        </LineChart>
                      </children>
                    </VBox>

                    <!-- Recent Auctions -->
                    <VBox spacing="18.0"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                      <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                      </padding>
                      <children>
                        <HBox alignment="CENTER_LEFT">
                          <children>
                            <Label text="Phiên đấu giá gần đây"
                              style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                              <font>
                                <Font size="16.0"/>
                              </font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Xem tất cả →" onAction="#handleMenuAuctions"
                              style="-fx-background-color: transparent; -fx-text-fill: #4285F4; -fx-cursor: hand; -fx-font-weight: bold;">
                              <font>
                                <Font size="12.0"/>
                              </font>
                            </Button>
                          </children>
                        </HBox>
                        <Separator/>
                        <VBox fx:id="vboxRecentAuctions" spacing="12.0"/>
                      </children>
                    </VBox>

                  </children>
                </VBox>

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- PANEL: SẢN PHẨM CỦA TÔI (MY ITEMS) -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <VBox fx:id="panelItems" spacing="20.0" visible="false" managed="false">
                  <padding>
                    <Insets bottom="40.0" left="35.0" right="35.0" top="30.0"/>
                  </padding>
                  <children>
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                      <children>
                        <Label text="Danh sách sản phẩm"
                          style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                          <font>
                            <Font size="18.0"/>
                          </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="cmbFilterItems" promptText="Tất cả" prefWidth="150.0"
                          style="-fx-background-color: #F4F7FC; -fx-background-radius: 8;"/>
                        <Button mnemonicParsing="false" onAction="#handleMenuAddItem"
                          style="-fx-background-color: linear-gradient(to right, #4285F4, #9B72CB); -fx-background-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10 25 10 25;"
                          text="+ Thêm sản phẩm">
                          <font>
                            <Font size="13.0"/>
                          </font>
                        </Button>
                      </children>
                    </HBox>
                    <FlowPane fx:id="flowMyItems" hgap="20.0" vgap="20.0"/>
                  </children>
                </VBox>

                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <!-- PANEL: ĐĂNG SẢN PHẨM (ADD ITEM) -->
                <!-- ══════════════════════════════════════════════════════════════════════ -->
                <VBox fx:id="panelAddItem" spacing="25.0" visible="false" managed="false">
                  <padding>
                    <Insets bottom="40.0" left="35.0" right="35.0" top="30.0"/>
                  </padding>
                  <children>

                    <Label text="Đăng sản phẩm mới"
                      style="-fx-font-weight: bold; -fx-text-fill: #222222;">
                      <font>
                        <Font size="18.0"/>
                      </font>
                    </Label>

                    <HBox spacing="30.0" alignment="TOP_LEFT">
                      <children>

                        <!-- Form bên trái -->
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 4);">
                          <padding>
                            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                          </padding>
                          <children>

                            <!-- Tên sản phẩm -->
                            <VBox spacing="8.0">
                              <children>
                                <Label text="Tên sản phẩm *" style="-fx-text-fill: #333333; -fx-font-weight: bold;">
                                  <font>
                                    <Font size="13.0"/>
                                  </font>
                                </Label>
                                <TextField fx:id="txtItemName" prefHeight="45.0"
                                  promptText="VD: iPhone 15 Pro Max 256GB"
                                  style="-fx-background-color: #F4F7FC; -fx-background-radius: 8; -fx-padding: 0 15 0 15; -fx-text-fill: #222222;">
                                  <font>
                                    <Font size="13.0"/>
                                  </font>
                                </TextField>
                                <Label fx:id="lblItemNameError" managed="false" visible="false"
                                  style="-fx-text-fill: #D96570;">
                                  <font>
                                    <Font name="System Italic" size="11.0"/>
                                  </font>
                                </Label>
                              </children>
                            </VBox>

                            <!-- Mô tả sản phẩm -->
                            <VBox spacing="8.0">
                              <children>
                                <Label text="Mô tả sản phẩm" style="-fx-text-fill: #333333; -fx-font-weight: bold;">
                                  <font>
                                    <Font size="13.0"/>
                                  </font>
                                </Label>
                                <Label text="Mô tả chi tiết về tình trạng, nguồn gốc, tính năng của sản phẩm" 
                                  style="-fx-text-fill: #777777;">
                                  <font>
                                    <Font size="11.0"/>
                                  </font>
                                </Label>
                                <TextArea fx:id="txtItemDescription" prefHeight="120.0"
                                  promptText="Nhập mô tả chi tiết sản phẩm..."
                                  style="-fx-background-color: #F4F7FC; -fx-background-radius: 8; -fx-padding: 12 15 12 15; -fx-text-fill: #222222;"
                                  wrapText="true">
                                  <font>
                                    <Font size="13.0"/>
                                  </font>
                                </TextArea>
                              </children>
                            </VBox>

                            <!-- Danh mục & Giá -->
                            <HBox spacing="20.0">
                              <children>
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                  <children>
                                    <Label text="Danh mục *" style="-fx-text-fill: #333333; -fx-font-weight: bold;">
                                      <font>
                                        <Font size="13.0"/>
                                      </font>
                                    </Label>
                                    <Label text="Chọn loại sản phẩm phù hợp" style="-fx-text-fill: #777777;">
                                      <font>
                                        <Font size="11.0"/>
                                      </font>
                                    </Label>
                                    <ComboBox fx:id="cmbItemCategory"
                                      maxWidth="Infinity" prefHeight="45.0"
                                      promptText="Chọn danh mục..."
                                      style="-fx-background-color: #F4F7FC; -fx-background-radius: 8; -fx-font-size: 13px;">
                                    </ComboBox>
                                    <Label fx:id="lblItemCategoryError" managed="false" visible="false"
                                      style="-fx-text-fill: #D96570;">
                                      <font>
                                        <Font name="System Italic" size="11.0"/>
                                      </font>
                                    </Label>
                                  </children>
                                </VBox>
                                
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                  <children>
                                    <Label text="Giá khởi điểm (đ) *" style="-fx-text-fill: #333333; -fx-font-weight: bold;">
                                      <font>
                                        <Font size="13.0"/>
                                      </font>
                                    </Label>
                                    <Label text="Giá bắt đầu đấu giá" style="-fx-text-fill: #777777;">
                                      <font>
                                        <Font size="11.0"/>
                                      </font>
                                    </Label>
