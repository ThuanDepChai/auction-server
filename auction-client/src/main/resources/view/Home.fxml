<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #F7F7F7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhom15.client.controller.HomeController">

    <top>
        <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 1 0;">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="20.0">
                    <children>
                        <Label style="-fx-text-fill: linear-gradient(to right, #4285F4, #9B72CB, #D96570); -fx-font-weight: bold;" text="✧ Gemini">
                            <font>
                                <Font size="32.0" />
                            </font>
                        </Label>

                        <HBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" style="-fx-border-color: #333333; -fx-border-radius: 25; -fx-border-width: 1.5;">
                            <children>
                                <TextField promptText="Tìm kiếm bất cứ thứ gì..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </TextField>
                                <ComboBox prefWidth="150.0" promptText="Tất cả danh mục" style="-fx-background-color: transparent; -fx-border-color: #E0E0E0; -fx-border-width: 0 0 0 1;" />
                                <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: linear-gradient(to right, #4285F4, #9B72CB, #D96570); -fx-background-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Tìm kiếm">
                                    <HBox.margin>
                                        <Insets right="5.0" />
                                    </HBox.margin>
                                </Button>
                            </children>
                            <padding>
                                <Insets left="15.0" />
                            </padding>
                        </HBox>

                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button mnemonicParsing="false" style="-fx-background-color: transparent;" text="Thông báo" />
                                <Button mnemonicParsing="false" style="-fx-background-color: transparent;" text="Giỏ hàng" />
                                <Label fx:id="lblWelcome" text="Chào, Người dùng!" textFill="#555555" />
                            </children>
                        </HBox>
                    </children>
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                </HBox>

                <HBox alignment="CENTER" prefHeight="40.0" spacing="30.0">
                    <children>
                        <Label style="-fx-cursor: hand;" text="Giao dịch hot" textFill="#D96570" />
                        <Label style="-fx-cursor: hand;" text="Điện tử" />
                        <Label style="-fx-cursor: hand;" text="Thời trang" />
                        <Label style="-fx-cursor: hand;" text="Nhà cửa &amp; Sân vườn" />
                        <Label style="-fx-cursor: hand;" text="Đồ sưu tầm" />
                        <Label style="-fx-cursor: hand;" text="Thể thao" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox spacing="30.0">
                    <padding>
                        <Insets bottom="50.0" left="50.0" right="50.0" top="30.0" />
                    </padding>
                    <children>

                        <AnchorPane prefHeight="200.0" style="-fx-background-color: linear-gradient(to right, #4285F4, #9B72CB); -fx-background-radius: 15;">
                            <children>
                                <Label layoutX="40.0" layoutY="50.0" text="Ưu đãi mùa hè cực sốc" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                </Label>
                                <Label layoutX="40.0" layoutY="100.0" text="Giảm giá lên đến 50% cho các dòng sản phẩm Gemini." textFill="WHITE">
                                    <font>
                                        <Font size="18.0" />
                                    </font>
                                </Label>
                                <Button layoutX="40.0" layoutY="140.0" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-text-fill: #4285F4; -fx-font-weight: bold;" text="Mua ngay" />
                            </children>
                        </AnchorPane>

                        <VBox spacing="15.0">
                            <children>
                                <Label text="Sản phẩm nổi bật">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>

                                <FlowPane hgap="20.0" vgap="20.0">
                                    <children>

                                        <VBox prefHeight="300.0" prefWidth="220.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                                            <children>
                                                <AnchorPane prefHeight="180.0" style="-fx-background-color: #F0F0F0; -fx-background-radius: 10 10 0 0;">
                                                    <children>
                                                        <Label layoutX="80.0" layoutY="80.0" text="IMG" textFill="#999999" />
                                                    </children></AnchorPane>
                                                <VBox spacing="5.0">
                                                    <padding>
                                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                    </padding>
                                                    <children>
                                                        <Label text="Tai nghe Gemini Pro Wireless" wrapText="true">
                                                            <font>
                                                                <Font size="15.0" />
                                                            </font>
                                                        </Label>
                                                        <Label text="2.500.000đ" textFill="#D96570">
                                                            <font>
                                                                <Font name="System Bold" size="18.0" />
                                                            </font>
                                                        </Label>
                                                        <Label text="Đã bán 1.2k" textFill="#888888">
                                                            <font>
                                                                <Font size="12.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                    </children>
                                </FlowPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>