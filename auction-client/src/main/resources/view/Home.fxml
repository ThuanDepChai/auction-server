<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1200.0"
  style="-fx-background-color: #f5f5f7;"
  stylesheets="@../css/styles.css"
  xmlns="http://javafx.com/javafx/21"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="com.nhom15.client.controller.HomeController">

  <top>
    <VBox styleClass="market-header">
      <children>
        <HBox alignment="CENTER_LEFT" prefHeight="30.0" styleClass="market-utility-row">
          <padding>
            <Insets left="28.0" right="28.0"/>
          </padding>
          <children>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
              <children>
                <Label text="Hi! Đăng nhập hoặc đăng ký" styleClass="utility-link"/>
                <Button mnemonicParsing="false" onAction="#handleSell" text="Kênh Người Bán" styleClass="utility-button"/>
                <Label text="Tin tức &amp; Hướng dẫn" styleClass="utility-link"/>
                <Label text="Tải ứng dụng" styleClass="utility-link"/>
              </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT" spacing="18.0">
              <children>
                <Label text="Ship to" styleClass="utility-link"/>
                <Button mnemonicParsing="false" onAction="#handleSell" text="Sell" styleClass="utility-button"/>
                <Label text="Wishlist" styleClass="utility-link"/>
                <Button mnemonicParsing="false" onAction="#handleNotification" text="Thông báo" styleClass="utility-button"/>
              </children>
            </HBox>
          </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="72.0" spacing="16.0" styleClass="market-main-row">
          <padding>
            <Insets left="28.0" right="28.0"/>
          </padding>
          <children>
            <HBox alignment="CENTER_LEFT" prefWidth="178.0" minWidth="178.0" spacing="9.0">
              <children>
                <ImageView fitHeight="42.0" fitWidth="42.0" preserveRatio="true">
                  <image>
                    <Image url="@../images/logo_gemini.png"/>
                  </image>
                </ImageView>
                <Label text="Gemini" styleClass="market-logo-text">
                  <font><Font size="26.0"/></font>
                </Label>
              </children>
            </HBox>

            <Button mnemonicParsing="false" text="Shop by category ▾" styleClass="shop-category-button"/>

            <StackPane alignment="CENTER" HBox.hgrow="ALWAYS">
              <children>
                <HBox alignment="CENTER" maxWidth="900.0" minWidth="520.0" prefWidth="860.0" spacing="12.0">
                  <children>
                    <HBox alignment="CENTER_LEFT" prefHeight="42.0" HBox.hgrow="ALWAYS" styleClass="market-search-box">
                      <padding>
                        <Insets left="16.0" right="4.0"/>
                      </padding>
                      <children>
                        <Label text="⌕" styleClass="market-search-icon"/>
                        <TextField fx:id="txtSearch" promptText="Tìm sản phẩm, mã đấu giá hoặc người bán"
                          HBox.hgrow="ALWAYS" styleClass="market-search-input">
                          <font><Font size="14.0"/></font>
                        </TextField>
                        <Separator orientation="VERTICAL" prefHeight="22.0">
                          <HBox.margin><Insets left="4.0" right="4.0"/></HBox.margin>
                        </Separator>
                        <ComboBox fx:id="cmbCategory" prefWidth="158.0" promptText="Tất cả" styleClass="market-search-category"/>
                      </children>
                    </HBox>
                    <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#handleSearch"
                      prefHeight="42.0" prefWidth="118.0" text="Search" styleClass="market-search-button"/>
                  </children>
                </HBox>
              </children>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" minWidth="292.0" prefWidth="292.0" spacing="8.0">
              <children>
                <Button mnemonicParsing="false" onAction="#handleNotification" text="🔔" styleClass="market-icon-button"/>
                <Button mnemonicParsing="false" onAction="#handleCart" text="🛒" styleClass="market-icon-button"/>
                <Button fx:id="btnSell" mnemonicParsing="false" onAction="#handleSell" text="+ Đăng bán" styleClass="market-sell-button"/>

                <AnchorPane prefWidth="116.0">
                  <children>
                    <Button fx:id="btnUserMenu" mnemonicParsing="false" onAction="#handleUserMenu" styleClass="market-user-button">
                      <graphic>
                        <HBox alignment="CENTER" spacing="8.0">
                          <children>
                            <StackPane fx:id="avatarPane" prefHeight="36.0" prefWidth="36.0" styleClass="market-avatar">
                              <children>
                                <ImageView fx:id="imgAvatar" fitHeight="36.0" fitWidth="36.0" preserveRatio="true" visible="false">
                                  <clip>
                                    <javafx.scene.shape.Circle centerX="18.0" centerY="18.0" radius="18.0"/>
                                  </clip>
                                </ImageView>
                                <Label fx:id="lblAvatarInitial" text="U" styleClass="market-avatar-text"/>
                              </children>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="1.0">
                              <children>
                                <Label text="Xin chào," styleClass="market-user-eyebrow"/>
                                <Label fx:id="lblUsername" text="Người dùng" styleClass="market-user-name"/>
                              </children>
                            </VBox>
                          </children>
                        </HBox>
                      </graphic>
                    </Button>

                    <VBox fx:id="userDropdown" visible="false" managed="false"
                      layoutX="-76.0" layoutY="46.0" prefWidth="206.0" spacing="2.0"
                      styleClass="market-user-dropdown">
                      <padding>
                        <Insets bottom="8.0" left="5.0" right="5.0" top="8.0"/>
                      </padding>
                      <children>
                        <Button fx:id="btnProfile" maxWidth="Infinity" mnemonicParsing="false"
                          onAction="#handleProfile" text="👤  Trang cá nhân" styleClass="market-dropdown-button"/>
                        <Button fx:id="btnMyOrders" maxWidth="Infinity" mnemonicParsing="false"
                          onAction="#handleMyOrders" text="📦  Đơn hàng của tôi" styleClass="market-dropdown-button"/>
                        <Button fx:id="btnSellerDashboard" maxWidth="Infinity" mnemonicParsing="false"
                          onAction="#handleSellerDashboard" text="🏪  Quản lý bán hàng" styleClass="market-dropdown-button"/>
                        <Button fx:id="btnWallet" maxWidth="Infinity" mnemonicParsing="false"
                          onAction="#handleWallet" text="💰  Ví của tôi" styleClass="market-dropdown-button"/>
                        <Separator>
                          <VBox.margin><Insets bottom="3.0" top="3.0"/></VBox.margin>
                        </Separator>
                        <Button fx:id="btnLogout" maxWidth="Infinity" mnemonicParsing="false"
                          onAction="#handleLogout" text="🚪  Đăng xuất" styleClass="market-dropdown-danger"/>
                      </children>
                    </VBox>
                  </children>
                </AnchorPane>
              </children>
            </HBox>
          </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="4.0" styleClass="market-nav-row">
          <padding>
            <Insets left="28.0" right="28.0"/>
          </padding>
          <children>
            <Button fx:id="btnCatHot" mnemonicParsing="false" onAction="#handleCategory" text="Giao dịch hot" styleClass="market-nav-active"/>
            <Button fx:id="btnCatElectronics" mnemonicParsing="false" onAction="#handleCategory" text="Điện tử" styleClass="market-nav-button"/>
            <Button fx:id="btnCatFashion" mnemonicParsing="false" onAction="#handleCategory" text="Thời trang" styleClass="market-nav-button"/>
            <Button fx:id="btnCatHome" mnemonicParsing="false" onAction="#handleCategory" text="Nhà cửa &amp; Sân vườn" styleClass="market-nav-button"/>
            <Button fx:id="btnCatCollect" mnemonicParsing="false" onAction="#handleCategory" text="Đồ sưu tầm" styleClass="market-nav-button"/>
            <Button fx:id="btnCatSport" mnemonicParsing="false" onAction="#handleCategory" text="Thể thao" styleClass="market-nav-button"/>
            <Button fx:id="btnCatBooks" mnemonicParsing="false" onAction="#handleCategory" text="Sách &amp; Văn phòng" styleClass="market-nav-button"/>
            <Button fx:id="btnCatToys" mnemonicParsing="false" onAction="#handleCategory" text="Đồ chơi &amp; Trẻ em" styleClass="market-nav-button"/>
          </children>
        </HBox>
      </children>
    </VBox>
  </top>

  <center>
    <ScrollPane fx:id="mainScrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
      <content>
        <VBox spacing="0.0">
          <children>
            <VBox spacing="18.0">
              <padding>
                <Insets bottom="34.0" left="32.0" right="32.0" top="18.0"/>
              </padding>
              <children>
                <AnchorPane fx:id="bannerContainer" minHeight="250.0" prefHeight="250.0" maxHeight="250.0" styleClass="shopee-sale-banner">
                  <children>
                    <ImageView fx:id="bannerImageView" managed="false" preserveRatio="true"/>

                    <VBox layoutX="42.0" layoutY="34.0" spacing="10.0">
                      <children>
                        <Label text="GEMINI AUCTION FEST" styleClass="sale-eyebrow"/>
                        <Label text="Săn deal đấu giá chạm đáy" styleClass="sale-headline"/>
                        <Label text="Hàng độc bản, thương hiệu lớn, giá mở phiên hấp dẫn mỗi ngày." styleClass="sale-subtitle"/>
                        <HBox spacing="10.0">
                          <children>
                            <Button text="Khám phá ngay" onAction="#handleSearch" styleClass="sale-primary-button"/>
                            <Label text="Miễn phí đăng bán • Bảo vệ người mua" styleClass="sale-note"/>
                          </children>
                        </HBox>
                      </children>
                    </VBox>

                    <HBox layoutX="492.0" layoutY="176.0" spacing="12.0">
                      <children>
                        <VBox alignment="CENTER" prefHeight="58.0" prefWidth="118.0" styleClass="sale-badge">
                          <children>
                            <Label text="50%" styleClass="sale-badge-value"/>
                            <Label text="deal nổi bật" styleClass="sale-badge-label"/>
                          </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="58.0" prefWidth="118.0" styleClass="sale-badge">
                          <children>
                            <Label text="24H" styleClass="sale-badge-value"/>
                            <Label text="phiên hot" styleClass="sale-badge-label"/>
                          </children>
                        </VBox>
                        <VBox alignment="CENTER" prefHeight="58.0" prefWidth="118.0" styleClass="sale-badge">
                          <children>
                            <Label text="0Đ" styleClass="sale-badge-value"/>
                            <Label text="phí xem" styleClass="sale-badge-label"/>
                          </children>
                        </VBox>
                      </children>
                    </HBox>

                    <HBox alignment="CENTER" layoutX="586.0" layoutY="228.0" spacing="6.0">
                      <children>
                        <Label text="●" styleClass="carousel-dot-active"/>
                        <Label text="●" styleClass="carousel-dot"/>
                        <Label text="●" styleClass="carousel-dot"/>
                        <Label text="●" styleClass="carousel-dot"/>
                      </children>
                    </HBox>
                  </children>
                </AnchorPane>

                <VBox spacing="0.0" styleClass="brand-strip">
                  <children>
                    <HBox alignment="CENTER_LEFT" prefHeight="44.0">
                      <children>
                        <Label text="GEMINI MALL" styleClass="brand-strip-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Xem tất cả &gt;" styleClass="brand-strip-link"/>
                      </children>
                    </HBox>
                    <GridPane hgap="0.0" vgap="0.0">
                      <children>
                        <Label text="SAMSUNG" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="brand-tile"/>
                        <Label text="APPLE" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="brand-tile"/>
                        <Label text="XIAOMI" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="brand-tile"/>
                        <Label text="NIKE" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="brand-tile"/>
                        <Label text="TOYOTA" GridPane.columnIndex="4" GridPane.rowIndex="0" styleClass="brand-tile"/>
                        <Label text="CANON" GridPane.columnIndex="5" GridPane.rowIndex="0" styleClass="brand-tile"/>
                        <Label text="BASEUS" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="brand-tile"/>
                        <Label text="SHOPDUNK" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="brand-tile"/>
                        <Label text="OPPO" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="brand-tile"/>
                        <Label text="VIVO" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="brand-tile"/>
                        <Label text="HONDA" GridPane.columnIndex="4" GridPane.rowIndex="1" styleClass="brand-tile"/>
                        <Label text="ADIDAS" GridPane.columnIndex="5" GridPane.rowIndex="1" styleClass="brand-tile"/>
                      </children>
                    </GridPane>
                  </children>
                </VBox>

                <HBox alignment="TOP_LEFT" spacing="20.0">
                  <children>
                    <VBox minWidth="220.0" prefWidth="220.0" spacing="18.0" styleClass="market-sidebar">
                      <children>
                        <VBox spacing="8.0">
                          <children>
                            <Label text="Shop by category" styleClass="sidebar-title"/>
                            <Button text="Tất cả danh mục" onAction="#handleSearch" styleClass="sidebar-link-active"/>
                            <Button fx:id="btnSideElectronics" text="Điện tử" onAction="#handleCategory" styleClass="sidebar-link"/>
                            <Button fx:id="btnSideFashion" text="Thời trang" onAction="#handleCategory" styleClass="sidebar-link"/>
                            <Button fx:id="btnSideCar" text="Xe cộ" onAction="#handleCategory" styleClass="sidebar-link"/>
                            <Button fx:id="btnSideCollect" text="Đồ sưu tầm" onAction="#handleCategory" styleClass="sidebar-link"/>
                            <Button fx:id="btnSideSport" text="Thể thao" onAction="#handleCategory" styleClass="sidebar-link"/>
                          </children>
                        </VBox>

                        <Separator/>

                        <VBox spacing="11.0">
                          <children>
                            <Label text="Bộ lọc tìm kiếm" styleClass="sidebar-title"/>
                            <Label text="Khoảng giá" styleClass="home-filter-label"/>
                            <ComboBox fx:id="cmbPriceFilter" onAction="#handleApplyFilters" maxWidth="Infinity" styleClass="home-filter-combo"/>
                            <Label text="Mục sản phẩm" styleClass="home-filter-label"/>
                            <ComboBox fx:id="cmbTypeFilter" onAction="#handleApplyFilters" maxWidth="Infinity" styleClass="home-filter-combo"/>
                            <Label text="Năm sản xuất / tạo tác" styleClass="home-filter-label"/>
                            <TextField fx:id="txtYearFilter" promptText="VD: 2020" maxWidth="Infinity" styleClass="home-filter-input"/>
                            <Label text="Nhãn hàng / tác giả" styleClass="home-filter-label"/>
                            <TextField fx:id="txtBrandFilter" promptText="VD: Nike, Toyota..." maxWidth="Infinity" styleClass="home-filter-input"/>
                            <Label text="Sắp xếp" styleClass="home-filter-label"/>
                            <ComboBox fx:id="cmbSortFilter" onAction="#handleApplyFilters" maxWidth="Infinity" styleClass="home-filter-combo"/>
                            <HBox spacing="8.0">
                              <children>
                                <Button fx:id="btnApplyFilters" mnemonicParsing="false" onAction="#handleApplyFilters" text="Áp dụng" HBox.hgrow="ALWAYS" styleClass="home-filter-apply"/>
                                <Button fx:id="btnResetFilters" mnemonicParsing="false" onAction="#handleResetFilters" text="Xóa" styleClass="home-filter-reset"/>
                              </children>
                            </HBox>
                            <Label text="Gợi ý: ô tô dùng năm sản xuất; thời trang dùng nhãn hàng; nghệ thuật dùng tác giả hoặc năm tạo tác." wrapText="true" styleClass="home-filter-hint"/>
                          </children>
                        </VBox>
                      </children>
                    </VBox>

                    <VBox spacing="24.0" HBox.hgrow="ALWAYS">
                      <children>
                        <VBox spacing="12.0">
                          <children>
                            <Label text="Gemini &gt; Marketplace &gt; Sản phẩm nổi bật" styleClass="breadcrumb-label"/>
                            <HBox alignment="CENTER_LEFT">
                              <children>
                                <Label text="Sản phẩm nổi bật" styleClass="market-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Sắp xếp:" styleClass="sort-label"/>
                                <Button text="Best Match ▾" styleClass="sort-button"/>
                              </children>
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                              <children>
                                <Button text="Brand ▾" styleClass="filter-chip"/>
                                <Button text="Condition ▾" styleClass="filter-chip"/>
                                <Button text="Price ▾" styleClass="filter-chip"/>
                                <Button text="Buying Format ▾" styleClass="filter-chip"/>
                                <Button text="☰ All Filters" styleClass="filter-chip"/>
                              </children>
                            </HBox>
                            <FlowPane fx:id="flowProducts" hgap="18.0" vgap="22.0"/>
                          </children>
                        </VBox>

                        <VBox spacing="12.0">
                          <children>
                            <HBox alignment="CENTER_LEFT">
                              <children>
                                <Label text="Đấu giá đang diễn ra" styleClass="market-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button mnemonicParsing="false" text="Xem tất cả →" styleClass="section-link-button"/>
                              </children>
                            </HBox>
                            <FlowPane fx:id="flowAuctions" hgap="18.0" vgap="22.0"/>
                          </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" prefHeight="82.0" spacing="20.0" styleClass="buyer-protection-banner">
                          <children>
                            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" spacing="4.0">
                              <children>
                                <Label text="Mua sắm an toàn với Gemini" styleClass="buyer-protection-title"/>
                                <Label text="Bảo vệ người mua toàn diện • Thanh toán bảo mật • Hoàn tiền nhanh chóng" styleClass="buyer-protection-text"/>
                              </children>
                            </VBox>
                            <Button text="Tìm hiểu thêm" styleClass="sale-primary-button"/>
                          </children>
                        </HBox>
                      </children>
                    </VBox>
                  </children>
                </HBox>
              </children>
            </VBox>

            <HBox alignment="CENTER_LEFT" prefHeight="72.0" spacing="24.0" styleClass="footer-cta">
              <padding>
                <Insets left="60.0" right="60.0"/>
              </padding>
              <children>
                <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" spacing="3.0">
                  <children>
                    <Label text="Mua sắm dễ dàng hơn" styleClass="footer-cta-title"/>
                    <Label text="Tận hưởng đấu giá uy tín, giao hàng nhanh và hoàn tiền không rắc rối." styleClass="footer-cta-text"/>
                  </children>
                </VBox>
                <Button text="Bắt đầu ngay" styleClass="footer-cta-button"/>
              </children>
            </HBox>

            <VBox styleClass="market-footer">
              <padding>
                <Insets bottom="24.0" left="60.0" right="60.0" top="34.0"/>
              </padding>
              <children>
                <GridPane hgap="38.0" vgap="18.0">
                  <children>
                    <VBox GridPane.columnIndex="0" spacing="8.0" prefWidth="200.0">
                      <children>
                        <Label text="Gemini" styleClass="footer-heading"/>
                        <Label text="Giới thiệu công ty" styleClass="footer-link"/>
                        <Label text="Tuyển dụng" styleClass="footer-link"/>
                        <Label text="Báo chí" styleClass="footer-link"/>
                      </children>
                    </VBox>
                    <VBox GridPane.columnIndex="1" spacing="8.0" prefWidth="220.0">
                      <children>
                        <Label text="Hỗ trợ khách hàng" styleClass="footer-heading"/>
                        <Label text="Trung tâm trợ giúp" styleClass="footer-link"/>
                        <Label text="Hướng dẫn đấu giá" styleClass="footer-link"/>
                        <Label text="Chính sách bảo mật" styleClass="footer-link"/>
                        <Label text="Điều khoản sử dụng" styleClass="footer-link"/>
                      </children>
                    </VBox>
                    <VBox GridPane.columnIndex="2" spacing="8.0" prefWidth="240.0">
                      <children>
                        <Label text="Liên hệ" styleClass="footer-heading"/>
                        <Label text="Hotline: 0979919087" styleClass="footer-link"/>
                        <Label text="Email: geminiauction@gmail.com" styleClass="footer-link"/>
                        <Label text="Địa chỉ: 36, Xuân Thuỷ" styleClass="footer-link"/>
                      </children>
                    </VBox>
                    <VBox GridPane.columnIndex="3" spacing="8.0" prefWidth="220.0">
                      <children>
                        <Label text="Theo dõi Gemini" styleClass="footer-heading"/>
                        <Label text="Facebook • Instagram • YouTube • X" styleClass="footer-link"/>
                        <TextField promptText="Email nhận bản tin" styleClass="newsletter-input"/>
                        <Button text="Đăng ký" styleClass="newsletter-button"/>
                      </children>
                    </VBox>
                  </children>
                </GridPane>
                <Separator styleClass="footer-separator">
                  <VBox.margin><Insets bottom="16.0" top="24.0"/></VBox.margin>
                </Separator>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                  <children>
                    <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                      <image>
                        <Image url="@../images/logo_gemini.png"/>
                      </image>
                    </ImageView>
                    <Label text="© 2026 Gemini Auction. All rights reserved." styleClass="footer-copy"/>
                  </children>
                </HBox>
              </children>
            </VBox>
          </children>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
